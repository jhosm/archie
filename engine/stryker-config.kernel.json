{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/schema/stryker-config.json",
  "stryker-config": {
    "reporters": [
      "html",
      "progress",
      "cleartext"
    ],
    "mutation-level": "Standard",
    "ignore-mutations": [
      "string"
    ],
    "ignore-methods": [
      "ArgumentNullException.ThrowIfNull"
    ],
    "thresholds": {
      "high": 100,
      "low": 95,
      "break": 90
    }
  }
}
