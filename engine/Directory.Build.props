<Project>
  <!-- Shared engine build settings. Runtime pinned by ADR-PC-010 (.NET 10 LTS). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- XML doc files feed the DocFX API reference site (ADR-PC-026). Doc COVERAGE is a docs
         concern, not a build gate: CS1591 (missing XML comment on a public member) and CS1573
         (some params documented, others not — records deliberately document only non-obvious
         positional params) are suppressed. Doc ROT stays an error under TreatWarningsAsErrors:
         malformed XML and unresolvable/ambiguous references (CS1570, CS1574, CS1734, CS0419, …)
         fail the build, so existing /// comments cannot silently decay. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <!-- NuGet audit (NU1902/NU1903) stays ON and warnings-as-errors for every package — except
       the four OpenTelemetry advisories below, which have NO fixed version on the 1.x line the
       OTel SDK ships (1.10/1.13/1.14 all flag them). They are moderate-severity, scoped to the
       trace SDK we wire at the host boundary (ADR-IC-007 Epic K.1). Suppressing the specific
       advisory IDs — not NU1902 wholesale — keeps the audit gate live for everything else; drop
       these entries when an advisory-clean OTel release is available. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g94r-2vxg-569j" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-8785-wc3w-h8q6" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-4625-4j76-fww9" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-mr8r-92fq-pj8p" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q834-8qmm-v933" />
  </ItemGroup>
</Project>
