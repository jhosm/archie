  <Folder Name="/load/">
    <!-- The in-house .NET v4-scale load harness (ADR-PC-011, Epic L.1): a generator/driver/observer
         that drives Redpanda with the engine's OWN Avro envelope code + seeded RNG + injected clock,
         and reads boundary-to-commit latency from the engine's OpenTelemetry spans. -->
    <Project Path="load/Babelstone.LoadHarness/Babelstone.LoadHarness.csproj" />
    <!-- The runnable acceptance-gate host (ADR-PC-011 §G4, Epic L.3 / bd babelstone-2e6q.1..4): wires
