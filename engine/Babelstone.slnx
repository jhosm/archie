    <Project Path="../notification/tests/Babelstone.Notification.Host.Tests/Babelstone.Notification.Host.Tests.csproj" />
    <!-- The lifecycle-command driver tests (ADR-PC-036 §Decision 2; bd babelstone-6cpq.7): Docker-free +
