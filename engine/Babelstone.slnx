    <Project Path="../notification/tests/Babelstone.Notification.Tests/Babelstone.Notification.Tests.csproj" />
    <!-- The DELIVERY-half tests (bd babelstone-60n8.4/.7): Docker-free + receiver-free — the ADR-IC-011
