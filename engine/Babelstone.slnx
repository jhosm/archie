    <!-- The shared host-composition contract assembly (ADR-PC-021 §A1, relocated 2026-06-20 /
         bd babelstone-9w2k.1): IFamilyHostModule + FamilyHostContext + the family-agnostic
         in-process hosting components a family module resolves. NOT a §P2 spine project (it may
         name a family in principle), so it stays out of the ENGINE_FAMILY_AGNOSTIC allowlist. -->
    <Project Path="src/Babelstone.Engine.Hosting/Babelstone.Engine.Hosting.csproj" />
    <!-- The canonical lifecycle-command idempotency-key LEAF (ADR-PC-036 Decision 1, LCD-1; extracted
         namespace-preserving from the hosting seam per bd babelstone-6cpq.13): System.*-only, so the
         lifecycle-driver core references the ONE key derivation without the hosting seam or the kernel. -->
    <Project Path="src/Babelstone.Engine.LifecycleKeys/Babelstone.Engine.LifecycleKeys.csproj" />
    <!-- The shared OTel instrumentation surface (ADR-IC-007 Layer 1, Epic K.1): ActivitySource + babelstone.* attribute keys. -->
    <Project Path="src/Babelstone.Telemetry/Babelstone.Telemetry.csproj" />
    <!-- The HOST-side OTel-SDK seam (K.5, bd scd2.3): Npgsql built-in query-telemetry registration,
         kept out of the SDK-free Babelstone.Telemetry so the engine spine never gains the SDK dep. -->
    <Project Path="src/Babelstone.Telemetry.Hosting/Babelstone.Telemetry.Hosting.csproj" />
    <!-- The real Avro IEventSerializer (E.4): Confluent/Avro deps stay out of Engine/EventStore. -->
    <Project Path="src/Babelstone.Engine.Avro/Babelstone.Engine.Avro.csproj" />
    <!-- The outbox→Redpanda relay (E.4): the only assembly touching both PostgreSQL and Redpanda. -->
    <Project Path="src/Babelstone.OutboxPublisher/Babelstone.OutboxPublisher.csproj" />
    <!-- The Redpanda→inbox consumer (G.2): the consumer-side mirror of the outbox relay — the only
         consumer-side assembly touching both Redpanda and PostgreSQL (the message_id dedup row). -->
    <Project Path="src/Babelstone.InboxConsumer/Babelstone.InboxConsumer.csproj" />
    <Project Path="src/Babelstone.RateSheets/Babelstone.RateSheets.csproj" />
    <Project Path="src/Babelstone.RateSheets.Api/Babelstone.RateSheets.Api.csproj" />
    <!-- The engine command/query HTTP boundary (ADR-PC-021 §D5, realized in E.5): the surface the MCP server calls. -->
    <Project Path="src/Babelstone.Engine.Api/Babelstone.Engine.Api.csproj" />
    <Project Path="src/Babelstone.Packs/Babelstone.Packs.csproj" />
    <!-- Loaded family schema (ADR-PC-019 §P1): lives under /families, built with the engine pipeline. -->
    <Project Path="../families/term-deposit/src/Babelstone.Families.TermDeposit/Babelstone.Families.TermDeposit.csproj" />
    <!-- The family decider / application layer (ADR-PC-021): the impure command-side project. -->
    <Project Path="../families/term-deposit/src/Babelstone.Families.TermDeposit.Application/Babelstone.Families.TermDeposit.Application.csproj" />
    <!-- The family's SAGA module (ADR-IC-018 §D1): the concrete ConstitutionProcess + bridge/router/
         commands/state-vocabulary + the ISagaModule, depending only on the substrate (family → substrate). -->
    <Project Path="../families/term-deposit/src/Babelstone.Families.TermDeposit.Orchestration/Babelstone.Families.TermDeposit.Orchestration.csproj" />
    <!-- The family's NOTIFICATION contribution (ADR-IC-019 §D1/§D4 + Amendment 2026-06-24, bd babelstone-9u70):
         the term-deposit maturity-reminder rule + template (the 14-day window, pt.notice.maturity) and the
         IFamilyNotificationModule, depending only on the notification core (family → core), never the kernel. -->
    <Project Path="../families/term-deposit/src/Babelstone.Families.TermDeposit.Notification/Babelstone.Families.TermDeposit.Notification.csproj" />
    <!-- The family's LIFECYCLE-COMMAND contribution (ADR-PC-036 §Decision 2/5; ADR-PC-021 §A3/§P4): the
         term-deposit MaturityRule + the IFamilyLifecycleModule that binds its Npgsql read-model store and
         registers the rule, discovered by the lifecycle host's assembly-scan. Family → core arrow, never the
         reverse; depends on the lifecycle driver core, not the kernel. -->
    <Project Path="../families/term-deposit/src/Babelstone.Families.TermDeposit.Lifecycle/Babelstone.Families.TermDeposit.Lifecycle.csproj" />
    <!-- The personal_loan family (ADR-PC-031 / ADR-PC-030 roadmap item 2): the closed-end personal-loan
         ASSET family — the 2nd family on the engine, mirroring the term-deposit liability. The pure-fold
         schema + the impure decider/application layer; same family → engine plugin arrow (ADR-PC-021). -->
    <Project Path="../families/personal-loan/src/Babelstone.Families.PersonalLoan/Babelstone.Families.PersonalLoan.csproj" />
    <Project Path="../families/personal-loan/src/Babelstone.Families.PersonalLoan.Application/Babelstone.Families.PersonalLoan.Application.csproj" />
    <!-- The personal-loan family's SAGA module (ADR-IC-018 §D1; bd babelstone-9z9w): the ISagaModule whose
         catalogue-generated FamilyIntegrationTopics declaration joins loan Movement-bearing events to the
         substrate settlement saga's consume set; the loan family runs no saga of its own yet, so its
         machine/bridge/router are inert stubs. Family → substrate arrow only. -->
    <Project Path="../families/personal-loan/src/Babelstone.Families.PersonalLoan.Orchestration/Babelstone.Families.PersonalLoan.Orchestration.csproj" />
    <!-- The personal-loan family's LIFECYCLE-COMMAND contribution (ADR-PC-036 §Decision 2/3/5): the recurring
         InstallmentRule + the IFamilyLifecycleModule that binds its forward installment-calendar Npgsql store
         and registers the rule, discovered by the lifecycle host's assembly-scan (family → core arrow). -->
    <Project Path="../families/personal-loan/src/Babelstone.Families.PersonalLoan.Lifecycle/Babelstone.Families.PersonalLoan.Lifecycle.csproj" />
    <!-- The in-house saga orchestrator (ADR-IC-003, Epic H.1): the hand-rolled ConstitutionProcess
         state machine + saga-state/transition persistence + idempotent inbox-driven advance. An
         extraction-ready subtree (ADR-PC-019 §P2) that builds with the engine pipeline. -->
    <Project Path="../orchestrator/src/Babelstone.Orchestrator/Babelstone.Orchestrator.csproj" />
    <!-- The family-AGNOSTIC saga substrate (ADR-IC-018 §P1/§P2): the runtime + stores + ports +
         ISagaModule plug-in, carrying no families/** or engine-kernel reference. -->
    <Project Path="../orchestrator/src/Babelstone.Orchestrator.Substrate/Babelstone.Orchestrator.Substrate.csproj" />
    <!-- The shared CADENCE machinery LIBRARY (ADR-PC-036 §Decision 2 + ADR-IC-019 mechanism reuse,
         bd babelstone-6cpq.6): the generic clock-owning poll-loop worker, the per-tick ISchedulePass
         abstraction, the IDedupeLedger + in-memory ledger, and the CompositeId primitive — extracted from the
         notification estate so the notification scheduler and the future lifecycle-command driver share one
         tested mechanism. Generic by construction: it carries NO families/** or engine-spine reference (the
         arrows point INTO it), so it is neither a §P1 core nor a §P2 spine project. Extraction-ready subtree
         (ADR-PC-019 §P2). -->
    <Project Path="../cadence/src/Babelstone.Cadence/Babelstone.Cadence.csproj" />
    <!-- The shared COMPOSITION discovery LIBRARY (ADR-PC-040 §D4): the generic FamilyModuleScanner every
         composition root's estate loader delegates its family-module discovery to — its own tiny assembly,
         separate from the Cadence poll-loop library above (discovery is composition machinery, not
         clock-owning cadence). Generic by construction: no families/**, no engine-spine reference, no
         packages at all. Extraction-ready subtree (ADR-PC-019 §P2). -->
    <Project Path="../composition/src/Babelstone.Composition/Babelstone.Composition.csproj" />
    <!-- The in-house notification family-AGNOSTIC core LIBRARY (ADR-IC-011, DEF-2 / bd babelstone-60n8.1/.2;
         §D4 split by bd babelstone-9u70): the poll loop, the per-tick schedule pass, the composite-id +
         dedupe, the storage-opaque ADR-PC-027 read client, and the IFamilyNotificationModule contribution
         port — with NO engine-kernel or family reference (ADR-IC-019 §D2/§P2; gated by
         NOTIFICATION_FAMILY_AGNOSTIC). Extraction-ready subtree (ADR-PC-019 §P2). -->
    <Project Path="../notification/src/Babelstone.Notification/Babelstone.Notification.csproj" />
    <!-- The notification DELIVERY half (bd babelstone-60n8.4/.7): the ADR-IC-004 per-service outbox +
         ADR-IC-011 HMAC-SHA256-signed webhook transport delivering NotificationDue at-least-once — ONE
         transport for the SCHEDULED and EVENT_DRIVEN legs, parameterised by trigger_kind. Family-agnostic
         like the core (gated by NOTIFICATION_FAMILY_AGNOSTIC alongside it); extraction-ready subtree
         (ADR-PC-019 §P2). -->
    <Project Path="../notification/src/Babelstone.Notification.Delivery/Babelstone.Notification.Delivery.csproj" />
    <!-- The notification worker HOST (ADR-IC-019 §D4/§A2 composition root, bd babelstone-9u70): the runnable
         Worker exe that holds the explicit list of family notification contributions, composes each, and runs
         the core loop. It is the ONE place that names a family (the §A2 exemption), so it is NOT a §P1 core
         project and NOTIFICATION_FAMILY_AGNOSTIC does not gate it. -->
    <Project Path="../notification/src/Babelstone.Notification.Host/Babelstone.Notification.Host.csproj" />
    <!-- The lifecycle-command driver CORE library (ADR-PC-036 §Decision 2, candidate A; bd babelstone-6cpq.7):
         the per-tick LifecycleSchedulePass (a Babelstone.Cadence ISchedulePass), the family-rule port
         (ILifecycleCommandRule + LifecycleCommandDecision), the dispatch ledger that makes a re-tick of an
         already-fired occurrence a no-op AND single-fires across replicas (ILifecycleDispatchLedger — the
         durable Postgres claim per ADR-PC-038, keyed on the server-derived number-pinned
         LifecycleCommandKey it references — not reinvents), the command-POST sink (ILifecycleCommandSink /
         HttpLifecycleCommandSink), and the clock-owning LifecycleWorker. REUSES Babelstone.Cadence; reaches the
         engine ONLY over the ADR-PC-029 command surface (the engine stays clockless —
         NO_CLOCK_DRIVEN_ENGINE_SIGNAL holds). Extraction-ready subtree (ADR-PC-019 §P2). -->
    <Project Path="../lifecycle-driver/src/Babelstone.Lifecycle/Babelstone.Lifecycle.csproj" />
    <!-- The lifecycle-command driver worker HOST (ADR-PC-036 §Decision 2; bd babelstone-6cpq.7): the runnable
         sibling deployable that owns the clock, ticks the Cadence worker, dedupes on the dispatch ledger, and
         POSTs due commands through the sink. A SEPARATE deployable — NOT inside Babelstone.Notification (money-
         command credential isolation) and NOT inside the engine assembly (a timer there trips BENG004). It is
         the composition root, so it is not a gated core project. -->
    <Project Path="../lifecycle-driver/src/Babelstone.Lifecycle.Host/Babelstone.Lifecycle.Host.csproj" />
  </Folder>
