<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.LoadHarness</RootNamespace>
    <AssemblyName>Babelstone.LoadHarness</AssemblyName>
    <!-- A class library, not an executable: the v1 acceptance gate (ADR-PC-011 §G4) is driven by
         the smoke test today and a host wires the full run later. Keeping it a library lets the
         test project exercise the generator/driver/observer modules Docker-free. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The PRODUCER seam (ADR-PC-011 §P1 Driver): the harness puts the engine's own Avro
         envelopes on Redpanda through the SAME Confluent.Kafka producer production uses. Pinned
         centrally (Directory.Packages.props). -->
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Confluent.SchemaRegistry" />
  </ItemGroup>

  <ItemGroup>
    <!-- READ-ONLY engine references (ADR-PC-011 §S2 ecosystem coherence): the harness reuses the
         engine's OWN serialization, envelope, clock and telemetry surface so the bytes the test
         puts on the bus are produced by the same code as production (§G1), with zero schema drift.

         Babelstone.Engine.Avro   — AvroEventSerializer.Encode(DomainEvent) → EncodedPayload: the
                                     exact production value bytes (§G1).
         Babelstone.Engine        — DomainEvent base + EncodedPayload (the serializer's output).
         Babelstone.EventStore    — the §P1 envelope identity trio the harness stamps onto each
                                     record (event_id / correlation_id / causation_id, partition_key).
         Babelstone.OutboxPublisher — OutboxRelayOptions: the producer config shape the harness mirrors.
         Babelstone.Telemetry     — BabelstoneTelemetry.ActivitySourceName + BabelstoneAttributes:
                                     the OTel surface the Observer reads latency from (§G2/§P2).
         Babelstone.FinancialTypes — Money (the integer-cents substrate the events carry).
         Babelstone.Families.TermDeposit — the catalogued family events the generator emits.
         Babelstone.Pii            — IPiiKeyStore: the per-subject transit-key seam the §M.6
                                     key-cardinality probe (bd c14p.2) seeds + measures against, so the
                                     probe exercises the engine's OWN OpenBao client, not a re-impl. -->
    <ProjectReference Include="../../src/Babelstone.Engine.Avro/Babelstone.Engine.Avro.csproj" />
    <ProjectReference Include="../../src/Babelstone.Engine/Babelstone.Engine.csproj" />
    <ProjectReference Include="../../src/Babelstone.EventStore/Babelstone.EventStore.csproj" />
    <ProjectReference Include="../../src/Babelstone.OutboxPublisher/Babelstone.OutboxPublisher.csproj" />
    <ProjectReference Include="../../src/Babelstone.Telemetry/Babelstone.Telemetry.csproj" />
    <ProjectReference Include="../../src/Babelstone.FinancialTypes/Babelstone.FinancialTypes.csproj" />
    <ProjectReference Include="../../../families/term-deposit/src/Babelstone.Families.TermDeposit/Babelstone.Families.TermDeposit.csproj" />
    <ProjectReference Include="../../src/Babelstone.Pii/Babelstone.Pii.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator/driver internals are exercised directly by the smoke/self-test without
         widening the public surface (the same posture the engine's own assemblies take). -->
    <InternalsVisibleTo Include="Babelstone.LoadHarness.Tests" />
  </ItemGroup>
</Project>
