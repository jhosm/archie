<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Line/branch coverage collector (build-time only; PrivateAssets=all keeps it
         out of any consuming graph). Activated by the XPlat Code Coverage VSTest collector. -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <!-- Generic-container support for OpenBao (no first-party module). Tests touching
         a real OpenBao carry [Trait("Category","Integration")]. -->
    <PackageReference Include="Testcontainers" />
    <!-- In-memory IConfiguration for the ConfigurationSecretProvider unit tests. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Babelstone.Pii/Babelstone.Pii.csproj" />
    <!-- The shared ContainerStartupGate (throttles concurrent Testcontainers startups). -->
    <ProjectReference Include="../Babelstone.TestFixtures/Babelstone.TestFixtures.csproj" />
  </ItemGroup>
</Project>
