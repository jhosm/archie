<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Real PostgreSQL (the inbox dedup table) + a generic container for Redpanda (no
         first-party Redpanda module). The Integration-trait tests carry
         [Trait("Category","Integration")]; the default CI lane filters them out. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers" />
    <!-- Produce the records the consumer reads back, framed in the documented Confluent wire
         format (the local WireFormat helper — no dependency on the producer assembly's internals). -->
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Confluent.SchemaRegistry" />
    <PackageReference Include="Confluent.SchemaRegistry.Serdes.Avro" />
    <PackageReference Include="Apache.Avro" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Babelstone.InboxConsumer/Babelstone.InboxConsumer.csproj" />
    <ProjectReference Include="../../src/Babelstone.Engine/Babelstone.Engine.csproj" />
    <ProjectReference Include="../../src/Babelstone.Engine.Avro/Babelstone.Engine.Avro.csproj" />
    <ProjectReference Include="../../src/Babelstone.EventStore/Babelstone.EventStore.csproj" />
    <ProjectReference Include="../../src/Babelstone.EventStore.Migrations/Babelstone.EventStore.Migrations.csproj" />
    <ProjectReference Include="../../src/Babelstone.FinancialTypes/Babelstone.FinancialTypes.csproj" />
    <ProjectReference Include="../../src/Babelstone.Telemetry/Babelstone.Telemetry.csproj" />
    <ProjectReference Include="../../../families/term-deposit/src/Babelstone.Families.TermDeposit/Babelstone.Families.TermDeposit.csproj" />
  </ItemGroup>
</Project>
