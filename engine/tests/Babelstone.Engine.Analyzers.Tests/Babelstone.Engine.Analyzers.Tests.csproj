<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Line/branch coverage collector (build-time only; PrivateAssets=all keeps it
         out of any consuming graph). Activated by the XPlat Code Coverage VSTest collector. -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <!-- The Roslyn surface the in-memory harness compiles + runs the analyser against. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The analyser under test (normal reference, to instantiate it + see its internal IDs). -->
    <ProjectReference Include="../../src/Babelstone.Engine.Analyzers/Babelstone.Engine.Analyzers.csproj" />
    <!-- The real Babelstone.Engine surface so test snippets implement the real IEventHandler. -->
    <ProjectReference Include="../../src/Babelstone.Engine/Babelstone.Engine.csproj" />
  </ItemGroup>
</Project>
