<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Layer 4 composes the engine host's endpoint map (EndpointDataSource / RouteEndpoint /
         IEndpointRouteBuilder / minimal-API MapPost·MapGet) against a collecting route builder, so the
         suite needs the ASP.NET Core shared framework — the same FrameworkReference the host carries.
         The suite stays HERMETIC (no server, no broker, no containers): it only READS the built route
         patterns, it never listens on a socket. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <!-- The committed *.openapi.yaml specs and infra/kong/kong.yml are read as YAML documents;
         YamlDotNet is the pack loader's already-pinned parser (Directory.Packages.props). The
         suite is HERMETIC — no server, no broker, no containers: it reflects the shipped DTO
         assemblies and reads committed files only. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- Layer 4 route-table composition. The engine COMPOSITION ROOT (the only project that may name a
         family, ADR-PC-021 §A2): it carries HostModuleLoader (the family-discovery seam Layer 4 replays)
         AND, via its family ProjectReferences, copies each Babelstone.Families.*.dll into this test's
         output dir — exactly the output-dir probe FamilyHostAssemblies() uses, so the personal_loan and
         term_deposit host modules are discovered here without a host boot (the same trick
         Babelstone.Engine.Api.Tests uses). -->
    <ProjectReference Include="../../src/Babelstone.Engine.Api/Babelstone.Engine.Api.csproj" />
    <!-- The personal_loan family's application assembly, referenced explicitly so its
         Babelstone.Families.PersonalLoan.Application.dll (carrying PersonalLoanHostModule + LoansEndpoints)
         lands in the output dir for the FamilyHostAssemblies() probe even should the transitive copy be
         elided — the same belt-and-braces anchor the host itself keeps (ADR-PC-021 §A3). -->
    <ProjectReference Include="../../../families/personal-loan/src/Babelstone.Families.PersonalLoan.Application/Babelstone.Families.PersonalLoan.Application.csproj" />

    <!-- The current_account family's application assembly, referenced explicitly for the same reason as
         the loan one above — its Babelstone.Families.CurrentAccount.Application.dll lands in the output
         dir for the FamilyHostAssemblies() probe — AND because the Layer-1 drift suite binds its account
         command/read DTOs (contracts/openapi/internal/engine-account-commands, engine-account-reads). -->
    <ProjectReference Include="../../../families/current-account/src/Babelstone.Families.CurrentAccount.Application/Babelstone.Families.CurrentAccount.Application.csproj" />

    <!-- The DTO assemblies whose wire shapes the committed OpenAPI specs document (Layers 1–3). -->
    <!-- Engine command surface + read DTOs (contracts/openapi/internal/engine-deposit-commands, specs/engine-reads). -->
    <ProjectReference Include="../../../families/term-deposit/src/Babelstone.Families.TermDeposit.Application/Babelstone.Families.TermDeposit.Application.csproj" />
    <!-- Pack-migration operator surface (contracts/openapi/internal/engine-pack-migrations). -->
    <ProjectReference Include="../../src/Babelstone.Engine.Hosting/Babelstone.Engine.Hosting.csproj" />
    <!-- Rate-sheet deploy surface (contracts/openapi/internal/engine-rate-sheets). -->
    <ProjectReference Include="../../src/Babelstone.RateSheets.Api/Babelstone.RateSheets.Api.csproj" />
    <!-- Edge constitute / process-status DTOs (specs/orchestrator-edge, specs/orchestrator-process-status).
         Already a member of engine/Babelstone.slnx, so no new build coupling. -->
    <ProjectReference Include="../../../orchestrator/src/Babelstone.Orchestrator/Babelstone.Orchestrator.csproj" />
  </ItemGroup>
</Project>
