<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Line/branch coverage collector (build-time only; PrivateAssets=all keeps it
         out of any consuming graph). Activated by the XPlat Code Coverage VSTest collector. -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Babelstone.Engine.Api/Babelstone.Engine.Api.csproj" />
    <ProjectReference Include="../../src/Babelstone.EventStore.Migrations/Babelstone.EventStore.Migrations.csproj" />
    <ProjectReference Include="../../src/Babelstone.RateSheets/Babelstone.RateSheets.csproj" />
    <!-- The shared ContainerStartupGate (throttles concurrent Testcontainers startups). -->
    <ProjectReference Include="../Babelstone.TestFixtures/Babelstone.TestFixtures.csproj" />
    <!-- HostModuleLoader negative-case fixture assemblies (bd babelstone-9w2k.2): a scan of each trips
         exactly ONE loader guard — a duplicate-family collision, or a module without a public
         parameterless ctor — so neither fault is ever in this test assembly's own happy-path scan. -->
    <ProjectReference Include="../fixtures/Babelstone.HostModuleLoader.DuplicateFixture/Babelstone.HostModuleLoader.DuplicateFixture.csproj" />
    <ProjectReference Include="../fixtures/Babelstone.HostModuleLoader.NoCtorFixture/Babelstone.HostModuleLoader.NoCtorFixture.csproj" />
  </ItemGroup>
</Project>
