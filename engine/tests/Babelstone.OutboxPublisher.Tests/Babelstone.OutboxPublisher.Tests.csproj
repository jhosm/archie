<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Line/branch coverage collector (build-time only; PrivateAssets=all keeps it
         out of any consuming graph). Activated by the XPlat Code Coverage VSTest collector. -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <!-- Real PostgreSQL (first-party module) + a generic container for Redpanda (no
         first-party Redpanda module — same shape as OpenBaoFixture). All tests here carry
         [Trait("Category","Integration")]; the default CI lane filters them out, the E.6
         integration lane runs them. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers" />
    <!-- Consume + Avro-deserialize the published records to assert field values + headers. -->
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Confluent.SchemaRegistry" />
    <PackageReference Include="Confluent.SchemaRegistry.Serdes.Avro" />
    <PackageReference Include="Apache.Avro" />
    <!-- The FORMAL Pact CDC producer half of the notify emit contract (bd babelstone-2t16.14,
         ADR-IC-009 §P2): NotificationDuePactProviderTests verifies the committed
         contracts/pact/notification-delivery-engine.json against a payload round-tripped through the
         engine-embedded governed schema + real Avro codec. Pinned 4.5 (see Directory.Packages.props —
         PactNet 5.0.x message verification is broken upstream, pact-net #530). TEST-only. -->
    <PackageReference Include="PactNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared Redpanda Testcontainers fixture (ic10): one source of the broker setup, reused
         by both the producer and consumer integration lanes instead of a copy-pasted fixture. -->
    <ProjectReference Include="../Babelstone.TestFixtures/Babelstone.TestFixtures.csproj" />
    <ProjectReference Include="../../src/Babelstone.OutboxPublisher/Babelstone.OutboxPublisher.csproj" />
    <ProjectReference Include="../../src/Babelstone.Engine/Babelstone.Engine.csproj" />
    <ProjectReference Include="../../src/Babelstone.Engine.Avro/Babelstone.Engine.Avro.csproj" />
    <ProjectReference Include="../../src/Babelstone.EventStore/Babelstone.EventStore.csproj" />
    <ProjectReference Include="../../src/Babelstone.EventStore.Migrations/Babelstone.EventStore.Migrations.csproj" />
    <ProjectReference Include="../../src/Babelstone.FinancialTypes/Babelstone.FinancialTypes.csproj" />
    <ProjectReference Include="../../../families/term-deposit/src/Babelstone.Families.TermDeposit/Babelstone.Families.TermDeposit.csproj" />
    <!-- personal_loan is referenced so its assembly lands in the output dir and the family-agnostic
         catalog sweeps (AvroCatalogSweepTests, CatalogGatedRelayReverseOrphanTests) can load it: its
         5 published .avsc are catalogued, so the catalogued ⊆ relay-capable biconditional needs the
         family's handler registrations present (ADR-IC-017 §P3). As more families ship published events
         their test references join here. -->
    <ProjectReference Include="../../../families/personal-loan/src/Babelstone.Families.PersonalLoan/Babelstone.Families.PersonalLoan.csproj" />
  </ItemGroup>
</Project>
