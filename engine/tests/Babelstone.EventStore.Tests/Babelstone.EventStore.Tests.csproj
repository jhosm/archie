<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Real PostgreSQL per test (ADR-IC-009). Tests touching it carry
         [Trait("Category","Integration")]; the default engine CI job filters
         them out and the integration lane (Q.1, gated on E.6) runs them. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="FsCheck.Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Babelstone.EventStore/Babelstone.EventStore.csproj" />
    <ProjectReference Include="../../src/Babelstone.EventStore.Migrations/Babelstone.EventStore.Migrations.csproj" />
    <!-- D.2 projection-runtime integration tests drive the generic runtime (ProjectionDrainer /
         ProjectionRunner) over a real PostgreSQL projection store with a synthetic family fold. -->
    <ProjectReference Include="../../src/Babelstone.Engine/Babelstone.Engine.csproj" />
  </ItemGroup>
</Project>
