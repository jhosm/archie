<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.EventStore.Migrations</RootNamespace>
    <AssemblyName>Babelstone.EventStore.Migrations</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The DDL is shipped as embedded, numbered, forward-only SQL resources
         (ADR-PC-001 §P5). The runner reads them out of the assembly so a deploy
         carries its own schema; there is no loose-file lookup at runtime. -->
    <EmbeddedResource Include="Sql/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Npgsql is the only dependency: this assembly runs DDL under the
         migration role (ADR-PC-001 §P3), separate from the engine's runtime
         role. It carries no domain types and no OpenBao/Kafka surface. -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>
</Project>
