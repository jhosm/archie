<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.OutboxPublisher</RootNamespace>
    <AssemblyName>Babelstone.OutboxPublisher</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The IC-004 reader half (event-store-skeleton §3/§5.4): the ONLY assembly that
         touches both PostgreSQL (the outbox, via Npgsql) and Redpanda (Confluent.Kafka).
         The engine's write half does not know Redpanda exists. Confluent deps stay HERE
         (and in Babelstone.Engine.Avro) — never in Babelstone.EventStore. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Confluent.SchemaRegistry" />
    <!-- BackgroundService/IHostedService for the §5.1 in-process poll loop. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reads OutboxRow / OutboxStatus from the event store (no Engine dependency: the
         relay is downstream of the write path, it only drains the table). -->
    <ProjectReference Include="../Babelstone.EventStore/Babelstone.EventStore.csproj" />
    <!-- The shared OTel surface (ADR-IC-007 Layer 1): the relay records the publish-lag SLI
         (ADR-IC-004 §P4) on BabelstoneTelemetry.Meter — never a new meter of its own. -->
    <ProjectReference Include="../Babelstone.Telemetry/Babelstone.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wire-format framing + reverse-DNS ce_type helpers are internal; the test project
         asserts them directly without widening the public surface. -->
    <InternalsVisibleTo Include="Babelstone.OutboxPublisher.Tests" />
    <!-- The load harness mirrors the relay's framing/header contract in its own WireFormat.cs
         (the relay's helpers being internal); the harness parity test (ADR-PC-011, bd a7f6) pins
         WireFormat against the relay's OutboxDrainer.ToConfluentWireFormat / BuildHeadersCore /
         ReverseDnsType so the duplicated framing cannot silently drift. Additive read-only grant —
         no engine source changes. -->
    <InternalsVisibleTo Include="Babelstone.LoadHarness.Tests" />
  </ItemGroup>
</Project>
