<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.Engine</RootNamespace>
    <AssemblyName>Babelstone.Engine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The orchestration layer (skeleton §2.1/§3): composes EventStore and Pii but
         does not leak their types upward — handlers see only Babelstone.Engine
         abstractions. Engine never references Npgsql directly; storage stays behind
         EventStore. -->
    <ProjectReference Include="../Babelstone.EventStore/Babelstone.EventStore.csproj" />
    <ProjectReference Include="../Babelstone.Pii/Babelstone.Pii.csproj" />

    <!-- Money is the engine's money type: the generic ISettlementPort (the legacy
         money-movement seam, ADR-PC-016) carries Money, never a float. FinancialTypes is a
         dependency-free value type, so this adds no transitive surface. -->
    <ProjectReference Include="../Babelstone.FinancialTypes/Babelstone.FinancialTypes.csproj" />

    <!-- The shared OTel instrumentation surface (ADR-IC-007): the ActivitySource the
         runtime shell opens product-semantic spans on, and the babelstone.* attribute-key
         contract. Carries only OpenTelemetry.Api (System.Diagnostics' ActivitySource) — no
         SDK, exporter, or family dependency — so the engine spine stays family-agnostic
         (catalogue ENGINE_FAMILY_AGNOSTIC) and SDK-free. Spans live here in the impure
         runtime, never in the pure decider/fold (ADR-PC-010 §P5). -->
    <ProjectReference Include="../Babelstone.Telemetry/Babelstone.Telemetry.csproj" />

    <!-- The handler-purity analysers (BENG001/002/003) guard any IEventHandler.Apply
         body compiled here. Passed as a checker, never linked
         (ReferenceOutputAssembly=false); warnings are errors per Directory.Build.props,
         so a clock/IO/rng call in a handler fails the build. Family-module projects
         attach the same analyser. -->
    <ProjectReference Include="../Babelstone.Engine.Analyzers/Babelstone.Engine.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
