<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.Engine.Avro</RootNamespace>
    <AssemblyName>Babelstone.Engine.Avro</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The contracts/avro/*.avsc are the single governed source (ADR-IC-002); embed ALL of
         them (a glob — a new family's .avsc needs no csproj edit) so a deploy carries its own
         schemas. The catalog discovers them by resource name; the codec is family-agnostic
         (ADR-PC-021 §D2), so no family is named here. -->
    <EmbeddedResource Include="../../../contracts/avro/*.avsc"
                      LogicalName="Babelstone.Engine.Avro.contracts.avro.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real IEventSerializer (Epic E.4) lives in its OWN assembly so the Confluent/Avro
         surface stays out of Babelstone.Engine and Babelstone.EventStore
         (event-store-skeleton §2.1/§5.4): Engine sees only the IEventSerializer seam, EventStore
         stays Npgsql-only. Apache.Avro builds the GenericRecord + value bytes; Confluent.SchemaRegistry
         resolves the schema_id per subject. -->
    <PackageReference Include="Apache.Avro" />
    <PackageReference Include="Confluent.SchemaRegistry" />
  </ItemGroup>

  <ItemGroup>
    <!-- ONLY the generic seam (Babelstone.Engine: IEventSerializer / DomainEvent) and Money
         (Babelstone.FinancialTypes). NO family reference (ADR-PC-021 §D2/§P2): the codec binds
         any event's constructor parameters to its .avsc fields by convention — adding a family is
         adding its .avsc, not a serializer. -->
    <ProjectReference Include="../Babelstone.Engine/Babelstone.Engine.csproj" />
    <ProjectReference Include="../Babelstone.FinancialTypes/Babelstone.FinancialTypes.csproj" />
  </ItemGroup>
</Project>
