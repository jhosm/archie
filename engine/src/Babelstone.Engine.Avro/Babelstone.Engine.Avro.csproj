<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.Engine.Avro</RootNamespace>
    <AssemblyName>Babelstone.Engine.Avro</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The value-conversion + field helpers (ToAvro/FromAvro/FieldName/RequireField) are internal;
         the codec's public surface stays Encode/Decode. The OutboxPublisher tests exercise the
         optional [null,T]-union path (ADR-IC-002 §P2) directly against these helpers — the part that
         must never silently drift — without needing a catalogued .avsc that carries an optional field. -->
    <InternalsVisibleTo Include="Babelstone.OutboxPublisher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- contracts/avro/{domain}/{aggregate_type}/{EventName}.avsc — the single governed source
         (ADR-IC-002 §P1 as amended). Embed ALL with a recursive glob so a new family's .avsc
         needs no csproj edit. The catalog is family-agnostic (ADR-PC-021 §D2): it resolves
         schemas from parsed content, never from the path. %(RecursiveDir) keeps the LogicalName
         unique when bare event-name files in different subdirs share a short name. -->
    <EmbeddedResource Include="../../../contracts/avro/**/*.avsc"
                      LogicalName="Babelstone.Engine.Avro.contracts.avro.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real IEventSerializer lives in its OWN assembly so the Confluent/Avro
         surface stays out of Babelstone.Engine and Babelstone.EventStore
         (event-store-skeleton §2.1/§5.4): Engine sees only the IEventSerializer seam, EventStore
         stays Npgsql-only. Apache.Avro builds the GenericRecord + value bytes; Confluent.SchemaRegistry
         resolves the schema_id per subject. -->
    <PackageReference Include="Apache.Avro" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Confluent.SchemaRegistry" />
  </ItemGroup>

  <ItemGroup>
    <!-- ONLY the generic seam (Babelstone.Engine: IEventSerializer / DomainEvent) and Money
         (Babelstone.FinancialTypes). NO family reference (ADR-PC-021 §D2/§P2): the codec binds
         any event's constructor parameters to its .avsc fields by convention — adding a family is
         adding its .avsc, not a serializer. -->
    <ProjectReference Include="../Babelstone.Engine/Babelstone.Engine.csproj" />
    <ProjectReference Include="../Babelstone.FinancialTypes/Babelstone.FinancialTypes.csproj" />
  </ItemGroup>
</Project>
