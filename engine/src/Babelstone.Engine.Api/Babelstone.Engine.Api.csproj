<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Babelstone.Engine.Api</RootNamespace>
    <AssemblyName>Babelstone.Engine.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine's command/query HTTP boundary (ADR-PC-021 §D5, realized in E.5; the
         RateSheets.Api minimal-API precedent, ADR-PC-008 Amendment A1). It composes the
         term-deposit decider (Babelstone.Families.TermDeposit.Application) over the durable
         runtime + rate-sheet store + pinned pack, and is the engine surface the Python MCP
         server (ADR-IC-010) calls. Authn/authz is the gateway's job (Epic J); this host is
         the auth-deferred dev boundary. -->
    <ProjectReference Include="../Babelstone.Engine/Babelstone.Engine.csproj" />
    <!-- The governed embedded-schema catalogue (ADR-IC-002 / ADR-IC-015), wired as the
         catalog-gated-relay membership predicate (ADR-IC-017 §P1): AvroSchemaCatalog implements the
         spine's IIntegrationEventCatalog, so the relay publishes an event IFF it is catalogued. This
         is a SPINE project (ENGINE_FAMILY_AGNOSTIC), and the host is the composition root that may
         name a family (ADR-PC-021 A2), so this reference is legitimate here, not in the spine. -->
    <ProjectReference Include="../Babelstone.Engine.Avro/Babelstone.Engine.Avro.csproj" />
    <ProjectReference Include="../Babelstone.EventStore/Babelstone.EventStore.csproj" />
    <ProjectReference Include="../Babelstone.RateSheets/Babelstone.RateSheets.csproj" />
    <ProjectReference Include="../Babelstone.Packs/Babelstone.Packs.csproj" />
    <ProjectReference Include="../Babelstone.FinancialTypes/Babelstone.FinancialTypes.csproj" />
    <!-- The application-credential secret boundary (ADR-PC-004 Amendment A1): ConnectionStrings:Engine
         resolves through ISecretProvider. Babelstone.Pii stays self-contained (no engine refs). -->
    <ProjectReference Include="../Babelstone.Pii/Babelstone.Pii.csproj" />
    <ProjectReference Include="../../../families/term-deposit/src/Babelstone.Families.TermDeposit/Babelstone.Families.TermDeposit.csproj" />
    <ProjectReference Include="../../../families/term-deposit/src/Babelstone.Families.TermDeposit.Application/Babelstone.Families.TermDeposit.Application.csproj" />

    <!-- The IC-004 outbox→Redpanda relay (G.1): this host co-runs the polling relay in-process
         (event-store-skeleton §5.1) so the §P4 publish-lag SLI (outbox_publish_lag_seconds) is
         actually emitted on the meter AddMeter()'d in Program.cs. The relay drains the outbox the
         engine write half fills; Confluent.Kafka stays confined to this assembly (never EventStore). -->
    <ProjectReference Include="../Babelstone.OutboxPublisher/Babelstone.OutboxPublisher.csproj" />

    <!-- OpenTelemetry tracing on this host (ADR-IC-007 Layer 1, Epic K.1): the SDK hosting
         integration (AddOpenTelemetry/ConfigureResource/WithTracing) + the OTLP exporter to the
         Collector (P1). The ActivitySource + babelstone.* attribute keys come transitively via
         Babelstone.Telemetry (through Babelstone.Engine); referenced explicitly so the resource
         helper (BabelstoneResource) is a first-order dependency of the composition root. -->
    <ProjectReference Include="../Babelstone.Telemetry/Babelstone.Telemetry.csproj" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <!-- Inbound-request instrumentation (bd babelstone-2dex): the inbound HTTP request becomes a
         SERVER span that adopts the caller's W3C traceparent, so the deposit.* custom spans nest
         under it (parented to the inbound trace) rather than starting as disconnected roots. -->
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>
</Project>
