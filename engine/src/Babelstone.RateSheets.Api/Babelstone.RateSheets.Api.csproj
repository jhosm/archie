<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Babelstone.RateSheets.Api</RootNamespace>
    <AssemblyName>Babelstone.RateSheets.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The treasury-gated deploy surface (ADR-PC-008 §P2): the first HTTP host in
         the engine. Authentication/authorization is the API gateway's job (§P4 /
         ADR-IC-010); this host validates, persists, and records the approver. -->
    <ProjectReference Include="../Babelstone.RateSheets/Babelstone.RateSheets.csproj" />

    <!-- The in-engine verified-pack loader (C.5, ADR-PC-007 §P4): the deploy's §P2 rate bound is
         read from the signed pack's parameters/constants.yaml keyed on pack_version, not a config
         knob. The host pre-loads packs at startup; the deploy handler resolves on the pure hot path. -->
    <ProjectReference Include="../Babelstone.Packs/Babelstone.Packs.csproj" />

    <!-- OpenTelemetry tracing (ADR-IC-007 Layer 1, Epic K.1): the shared resource helper
         (BabelstoneResource) + the SDK hosting integration and OTLP exporter, for OBS-1 parity
         with the engine host. -->
    <ProjectReference Include="../Babelstone.Telemetry/Babelstone.Telemetry.csproj" />
    <!-- The host-side OTel-SDK seam (K.5, bd scd2.3): registers Npgsql's built-in query CLIENT spans
         on this host's existing TracerProvider so the rate-sheet store's Postgres calls are visible in
         the trace too (OBS-1 parity with the engine host). Kept out of the SDK-free Babelstone.Telemetry. -->
    <ProjectReference Include="../Babelstone.Telemetry.Hosting/Babelstone.Telemetry.Hosting.csproj" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
</Project>
