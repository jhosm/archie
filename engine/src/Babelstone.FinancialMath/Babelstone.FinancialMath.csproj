<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.FinancialMath</RootNamespace>
    <AssemblyName>Babelstone.FinancialMath</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test assembly pins the IRR solver's numeric core (PresentValue /
         PresentValueAndDerivative) directly: the public API's Newton+bisection fallback
         makes a wrong PV/derivative unobservable from outside, so mutation testing
         needs internal visibility to prove that core correct. -->
    <InternalsVisibleTo Include="Babelstone.FinancialMath.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Accrual and withholding produce Money: the kernel rounds the fully
         computed decimal to cents exactly once via Money.FromCents (ADR-PC-010). -->
    <ProjectReference Include="../Babelstone.FinancialTypes/Babelstone.FinancialTypes.csproj" />

    <!-- The ADR-PC-010 boundary analysers guard the kernel too: it is where decimal
         accrual math crosses to Money, so the decimal-state ban (BMNY002) and
         the round-once rule (BMNY001) most need enforcing. Passed as a checker, never
         linked (ReferenceOutputAssembly=false); warnings are errors per
         Directory.Build.props, so a BMNY00x violation fails the build. -->
    <ProjectReference Include="../Babelstone.Money.Analyzers/Babelstone.Money.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
