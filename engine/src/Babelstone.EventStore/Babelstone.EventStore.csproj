<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.EventStore</RootNamespace>
    <AssemblyName>Babelstone.EventStore</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Npgsql-only by design (event-store-skeleton §2.1/§3): no OpenBao client,
         no Confluent.Kafka, no domain types. Storage sees ciphertext inside the
         self-describing JSON payload (ADR-PC-028) and does not know it is encrypted.
         A future Go re-implementation of this assembly is what ADR-PC-001 §S3's
         "lowest exit cost" cashes out as. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pack-version registry seam (IPackVersionRegistry/PackRef) and the fail-loud
         PackLoadException (ADR-PC-007 §P3). Babelstone.Packs is pure types + the loader
         seam — it owns no state and carries no Npgsql/EventStore surface — so this
         reference is one-directional and storage stays the only home of the pack_versions
         table the durable registry (PostgresPackVersionRegistry) reads. -->
    <ProjectReference Include="../Babelstone.Packs/Babelstone.Packs.csproj" />
  </ItemGroup>
</Project>
