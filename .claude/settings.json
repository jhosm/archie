{
  "extraKnownMarketplaces": {
    "babelstone-engine": {
      "source": { "source": "directory", "path": "." }
    }
  },
  "enabledPlugins": {
    "babelstone-engine@babelstone-engine": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
