<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.Families.PersonalLoan.Application</RootNamespace>
    <AssemblyName>Babelstone.Families.PersonalLoan.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The family's OWN read-model schema, shipped as embedded, numbered, forward-only SQL
         resources (ADR-PC-001 §P5), the same discipline as the engine event-store set and the
         term-deposit family set. The family-named read_model.installment_calendar table is OWNED here
         (ADR-PC-021 family-owned ownership), not in the engine migrations — so the engine event-store
         migrations carry zero family-named tables. The MigrationRunner reads these out of the assembly
         so a deploy carries its own schema; there is no loose-file lookup at runtime. -->
    <EmbeddedResource Include="Migrations/Sql/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Npgsql becomes a DIRECT dependency (it was only transitive via the engine ports): the family
         now owns a MigrationRunner that runs DDL under the migration role (ADR-PC-001 §P3) against the
         shared Postgres tier (ADR-IC-005 §S1), distinct from the engine runtime role. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core abstractions for this family's OWN host composition (ADR-PC-021 §A1, bd
         babelstone-9g77): PersonalLoanHostModule registers services + maps the /v1/loans surface;
         LoansEndpoints uses the minimal-API types (IEndpointRouteBuilder, Results, IResult,
         StatusCodes). A FrameworkReference on a plain .NET SDK project — the family is not a web app, it
         contributes its host wiring as a library the host composes (the family → engine/hosting arrow
         only). Mirrors the term-deposit Application project. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The personal_loan DECIDER (ADR-PC-021): the impure command-side layer that turns a command
         into events. Unlike the pure-fold project (Babelstone.Families.PersonalLoan, which references
         only Engine + FinancialTypes so a fold cannot reach a DB), the decider orchestrates I/O — it
         runs the amortization kernel, resolves the rate sheet + pack primitives, and appends through the
         runtime. The dependency arrow is family→engine only; the engine never references back
         (ADR-PC-021 §D2/§P2). No handler-purity analyser here by design (ADR-PC-021 §P3): this is the
         impure layer, reviewed by the financial-math / silent-failure / replay-determinism lenses. -->
    <ProjectReference Include="../Babelstone.Families.PersonalLoan/Babelstone.Families.PersonalLoan.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.Engine/Babelstone.Engine.csproj" />
    <!-- The shared host-composition contract assembly (ADR-PC-021 §A1): IFamilyHostModule +
         FamilyHostContext + the family-agnostic in-process hosting components (ProjectionRelayService/
         Options, BusEventSerializer marker) PersonalLoanHostModule resolves. Referencing it (not the
         host) lets the module live here without a family → host cycle; Babelstone.Engine.Hosting →
         Babelstone.Engine keeps the arrow engine-ward (bd babelstone-9g77). -->
    <ProjectReference Include="../../../../engine/src/Babelstone.Engine.Hosting/Babelstone.Engine.Hosting.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.FinancialMath/Babelstone.FinancialMath.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.FinancialTypes/Babelstone.FinancialTypes.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.RateSheets/Babelstone.RateSheets.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.Packs/Babelstone.Packs.csproj" />
  </ItemGroup>
</Project>
