<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Line/branch coverage collector (build-time only; PrivateAssets=all keeps it
         out of any consuming graph). Activated by the XPlat Code Coverage VSTest collector. -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gated-route test names Microsoft.AspNetCore.Http.IHeaderDictionary / HeaderDictionary to round-trip
         the scope InstallmentRule presents through Babelstone.Engine.Hosting.ScaServicePrincipal.IsAuthorised —
         proving the engine's SCA-gated /installment money-mover ADMITS the legit driver, not 422 (bd
         babelstone-6cpq.14/.15). FrameworkReference is non-transitive, so this plain test SDK project must
         declare it itself to compile against the same ASP.NET Core abstractions the engine host wiring uses. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The family LIFECYCLE contribution under test: InstallmentRule (the recurring installment decision keyed
         on the stable installment NUMBER, the re-tick no-op, the advance-to-N+1-only-after-N-paid invariant, the
         collection-account recovery, the no-SCA-principal case), driven over a fake installment-calendar store
         with the real LifecycleSchedulePass + dispatch ledger — no engine, no Docker. The contribution brings
         the driver core's family-rule port (ILifecycleCommandRule / LifecycleCommandDecision) and the
         LifecycleCommandKey seam via its project reference. The core's own dedupe + dispatch-id are tested in
         Babelstone.Lifecycle.Tests. -->
    <ProjectReference Include="../../src/Babelstone.Families.PersonalLoan.Lifecycle/Babelstone.Families.PersonalLoan.Lifecycle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The LCD-2 settlement-health gate's INTEGRATION twin (ADR-PC-036 §Decision 4; bd babelstone-6cpq.10):
         the real PostgresSettlementHealthProbe read against the ORCHESTRATOR'S REAL saga_state schema — a
         PostgreSQL container the orchestrator's own migration set is applied to. Npgsql for the fixture's
         row inserts; the shared TestFixtures GatedStartAsync gates the container start; excluded from the
         Docker-free lane by the Category!=Integration convention. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- The orchestrator SUBSTRATE (a family-agnostic core, fine for a TEST project to name): its
         MigrationRunner applies the real saga_state schema, and its SettlementProcess.Type /
         States.HumanInterventionRequired constants are asserted byte-for-byte against the probe's PINNED
         wire literals — the cross-service lock-step check the extraction-ready posture demands. -->
    <ProjectReference Include="../../../../orchestrator/src/Babelstone.Orchestrator.Substrate/Babelstone.Orchestrator.Substrate.csproj" />
    <ProjectReference Include="../../../../engine/tests/Babelstone.TestFixtures/Babelstone.TestFixtures.csproj" />
  </ItemGroup>
</Project>
