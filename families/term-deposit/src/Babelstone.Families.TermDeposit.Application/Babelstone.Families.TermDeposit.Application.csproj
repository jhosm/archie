<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.Families.TermDeposit.Application</RootNamespace>
    <AssemblyName>Babelstone.Families.TermDeposit.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The family's OWN read-model schema, shipped as embedded, numbered, forward-only SQL
         resources (ADR-PC-001 §P5), the same discipline as the engine event-store set. The
         family-named read_model.deposits table is OWNED here (ADR-PC-021 family-owned ownership),
         not in the engine migrations — so the engine event-store migrations carry zero
         family-named tables. The MigrationRunner reads these out of the assembly so a deploy
         carries its own schema; there is no loose-file lookup at runtime. -->
    <EmbeddedResource Include="Migrations/Sql/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Npgsql becomes a DIRECT dependency (it was only transitive via the engine ports): the
         family now owns a MigrationRunner that runs DDL under the migration role (ADR-PC-001 §P3)
         against the shared Postgres tier (ADR-IC-005 §S1), distinct from the engine runtime role. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core abstractions for this family's OWN host composition (ADR-PC-021 §A1 — the
         IFamilyHostModule, endpoints, and HTTP contracts relocated INTO the family here, 2026-06-20 /
         bd babelstone-9w2k.1, so the host no longer compile-references the family for these types).
         TermDepositHostModule registers services + maps the /v1/deposits surface; DepositsEndpoints
         uses the minimal-API types (IEndpointRouteBuilder, Results, IResult, StatusCodes). A
         FrameworkReference on a plain .NET SDK project — the family is not a web app, it contributes
         its host wiring as a library the host composes (the family → engine/hosting arrow only). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The term-deposit DECIDER (ADR-PC-021): the impure command-side layer that turns a
         command into events. Unlike the pure-fold project (Babelstone.Families.TermDeposit,
         which references only Engine + FinancialTypes so a fold cannot reach a DB), the
         decider orchestrates I/O — it runs the financial-math kernel, resolves the rate
         sheet + pack primitives, and appends through the runtime. The dependency arrow is
         family→engine only; the engine never references back (ADR-PC-021 §D2/§P2). The
         handler-purity legs (BENG001–003) impose no constraint here by design (ADR-PC-021 §P3):
         this is the impure layer and implements no IEventHandler.Apply fold, so they are vacuous —
         see the BENG005 analyser wiring below (bd njt2.12), which attaches the suite for the no-PII
         telemetry tripwire. -->
    <ProjectReference Include="../Babelstone.Families.TermDeposit/Babelstone.Families.TermDeposit.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.Engine/Babelstone.Engine.csproj" />
    <!-- The shared host-composition contract assembly (ADR-PC-021 §A1, relocated 2026-06-20):
         IFamilyHostModule + FamilyHostContext + the family-agnostic in-process hosting components
         (BusEventSerializer marker, ProjectionRelayService/Options) this family's module resolves.
         Referencing it (not the host) is what lets the module live here without a family → host
         cycle; Babelstone.Engine.Hosting → Babelstone.Engine keeps the arrow engine-ward. -->
    <ProjectReference Include="../../../../engine/src/Babelstone.Engine.Hosting/Babelstone.Engine.Hosting.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.FinancialMath/Babelstone.FinancialMath.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.FinancialTypes/Babelstone.FinancialTypes.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.RateSheets/Babelstone.RateSheets.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.Packs/Babelstone.Packs.csproj" />

    <!-- BENG005 no-PII telemetry tripwire (bd njt2.12): attach the Babelstone.Engine.Analyzers suite as
         a BUILD-TIME checker (OutputItemType=Analyzer, ReferenceOutputAssembly=false — passed, never
         linked). Analyzer ProjectReferences are non-transitive, so without this line BENG005 ran on NONE
         of this impure shell's Activity.SetTag sites. It is a SECONDARY backstop to the load-bearing
         runtime guard (AddBabelstonePiiGuard, Babelstone.Telemetry.Hosting), future-proofing the one
         shape that guard cannot pre-empt at review time: a literal PII key/value hard-coded at a call
         site. Vacuous on today's sites (every key a babelstone.* const, every value a runtime expression).
         The handler-purity (BENG001–003) and no-clock-emission (BENG004) legs ride along inert: this
         layer has no IEventHandler.Apply fold, and its event creations take INJECTED time, never a clock. -->
    <ProjectReference Include="../../../../engine/src/Babelstone.Engine.Analyzers/Babelstone.Engine.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
