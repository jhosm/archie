<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Line/branch coverage collector (build-time only; PrivateAssets=all keeps it
         out of any consuming graph). Activated by the XPlat Code Coverage VSTest collector. -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The family notification contribution under test: MaturityReminderRule + WithholdingStatementRule
         (window/template selection, IsActive filter, fail-loud pack pinning) AND the family-owned
         DepositReadClient (DepositReadClientTests), all driven over a fake HttpMessageHandler — no engine,
         no Docker. The contribution defines the deposit-shaped read client itself (ADR-IC-019 D1) and
         brings the family-agnostic core's contribution port (ReminderDecision, the schedule-rule contract)
         via its project reference. The core's own dedupe + composite-id are tested in
         Babelstone.Notification.Tests. -->
    <ProjectReference Include="../../src/Babelstone.Families.TermDeposit.Notification/Babelstone.Families.TermDeposit.Notification.csproj" />
  </ItemGroup>
</Project>
