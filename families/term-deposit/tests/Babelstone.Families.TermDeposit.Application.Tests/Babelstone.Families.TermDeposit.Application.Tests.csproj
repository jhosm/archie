<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Line/branch coverage collector (build-time only; PrivateAssets=all keeps it
         out of any consuming graph). Activated by the XPlat Code Coverage VSTest collector. -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- The integration test asserts events/outbox row counts directly against PostgreSQL. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <!-- ScaServicePrincipalTests names Microsoft.AspNetCore.Http.IHeaderDictionary / HeaderDictionary
         to exercise the scoped non-interactive SCA service principal (ADR-PC-036, bd babelstone-6cpq.4).
         FrameworkReference is non-transitive, so the plain test SDK project must declare it itself to
         compile against the same ASP.NET Core abstractions the Application project's host wiring uses. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The decider under test, plus the storage + config bits the integration test wires as
         the composition root (ADR-PC-021 §D4): event store + migrations, the rate-sheet store,
         and the pack parser. The pure decider tier needs only the family + math (transitive). -->
    <ProjectReference Include="../../src/Babelstone.Families.TermDeposit.Application/Babelstone.Families.TermDeposit.Application.csproj" />
    <ProjectReference Include="../../src/Babelstone.Families.TermDeposit/Babelstone.Families.TermDeposit.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.Engine/Babelstone.Engine.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.EventStore/Babelstone.EventStore.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.EventStore.Migrations/Babelstone.EventStore.Migrations.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.RateSheets/Babelstone.RateSheets.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.Packs/Babelstone.Packs.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.FinancialMath/Babelstone.FinancialMath.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.FinancialTypes/Babelstone.FinancialTypes.csproj" />
    <!-- The shared ContainerStartupGate (throttles concurrent Testcontainers startups). -->
    <ProjectReference Include="../../../../engine/tests/Babelstone.TestFixtures/Babelstone.TestFixtures.csproj" />
  </ItemGroup>
</Project>
