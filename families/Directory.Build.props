<Project>
  <!-- Loaded family schemas are built and unit-tested as part of the engine pipeline
       (families/README.md, ADR-PC-019 §P1), so they inherit the same build settings as
       engine/ — net10.0, nullable, warnings-as-errors, deterministic. engine/Directory.Build.props
       is self-contained (it imports no parent), so importing it here replicates those
       settings for /families without duplicating them. -->
  <Import Project="../engine/Directory.Build.props" />
</Project>
