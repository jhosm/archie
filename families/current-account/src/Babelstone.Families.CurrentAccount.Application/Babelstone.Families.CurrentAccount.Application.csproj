<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.Families.CurrentAccount.Application</RootNamespace>
    <AssemblyName>Babelstone.Families.CurrentAccount.Application</AssemblyName>
  </PropertyGroup>

  <!-- Minimal-API types (IEndpointRouteBuilder, Results, MapPost/MapGet) on a plain .NET SDK library:
       the family is a library the host composes, not a web app, so it takes the ASP.NET Core shared
       framework as a reference, exactly like the deposit / loan Application projects. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The current_account DECIDER + HOST WIRING (ADR-PC-021 / ADR-PC-037): the impure command-side
         layer that turns a command into events and composes the family into the running host. Unlike the
         pure-fold project (Babelstone.Families.CurrentAccount, which references only Engine +
         FinancialTypes so a fold cannot reach a DB), this layer consults the LifecycleTransitions legality
         table and appends through the runtime, and carries the IFamilyHostModule + /v1/accounts endpoints
         the host discovers by assembly-scan. No handler-purity analyser here by design (ADR-PC-021): this
         is the impure layer, reviewed by the replay-determinism / silent-failure lenses. The dependency
         arrow is family→engine only (ADR-PC-021).
         This project holds the LIFECYCLE-command decider + its orchestration (open/dormant/reactivate/
         close) and the host wiring; the synchronous AUTHORIZE decider + its declined taxonomy is its
         sibling authorize path. -->
    <ProjectReference Include="../Babelstone.Families.CurrentAccount/Babelstone.Families.CurrentAccount.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.Engine/Babelstone.Engine.csproj" />
    <!-- The IFamilyHostModule + FamilyHostContext contract assembly (ADR-PC-021): referencing the HOSTING
         library (not the host) is what lets the family plug into the host without a family→host cycle. -->
    <ProjectReference Include="../../../../engine/src/Babelstone.Engine.Hosting/Babelstone.Engine.Hosting.csproj" />
    <!-- VerifiedPack — the pinned pack the lifecycle service stamps onto each EventEnvelope (ADR-PC-009). -->
    <ProjectReference Include="../../../../engine/src/Babelstone.Packs/Babelstone.Packs.csproj" />
    <ProjectReference Include="../../../../engine/src/Babelstone.FinancialTypes/Babelstone.FinancialTypes.csproj" />
  </ItemGroup>
</Project>
