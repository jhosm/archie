<!-- The lifecycle-command driver worker HOST — the new sibling deployable (ADR-PC-036 §Decision 2,
     candidate A; bd babelstone-6cpq.7). In plain terms: this is the runnable, always-on process that owns the
     clock the engine deliberately lacks, ticks on a cadence, finds the lifecycle steps that are due today, and
     POSTs each to the engine's command surface exactly once. It is the composition root: it resolves the
     engine base URL, wires the typed command-POST HttpClient, the dispatch ledger, the cadence knobs and the
     clock, registers the per-tick pass over the family rules, and runs the clock-owning worker.

     A SEPARATE deployable, deliberately (ADR-PC-036 §Decision 2 / candidate B folded into A): it is NOT inside
     the read-only Babelstone.Notification context (so the money-command credential is isolated from the
     disclosures context) and NOT inside the engine assembly (a timer there trips BENG004 /
     NO_CLOCK_DRIVEN_ENGINE_SIGNAL). It mirrors the notification worker host shape (Microsoft.NET.Sdk.Worker, a
     BackgroundService poll-loop host, NOT an HTTP API) but is its own process. Single-firing/leader-election,
     monitoring and a durable dispatch ledger are operating concerns it owns as it hardens
     (ADR-PC-036 §Consequences) — the v1 host is the clockless-engine-honoring skeleton: Cadence worker +
     dispatch ledger + command-POST sink.

     Extraction-ready subtree (ADR-PC-019 §P2): the host carries its OWN copy of the shared build settings
     rather than inheriting engine/Directory.Build.props, exactly as the notification host does. -->
<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Babelstone.Lifecycle.Host</RootNamespace>
    <AssemblyName>Babelstone.Lifecycle.Host</AssemblyName>

    <!-- The ADR-PC-040 §D2 covenant role: this host is its estate's COMPOSITION ROOT — the one
         explicit, visible opt-out that MAY ProjectReference families/** (the ADR-PC-021 §A2
         standing-exemption pattern: the family references are the module loader's scan anchor).
         Every project WITHOUT this marker is a family-agnostic core by default, gated repo-wide by
         FAMILY_TO_CORE_DEFAULT_DENY; a marked root is gated instead by
         COMPOSITION_ROOT_NAMES_NO_FAMILY (its Program.cs names no Babelstone.Families.* type). -->
    <BabelstoneRole>CompositionRoot</BabelstoneRole>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ASP.NET shared framework, pulled into the runtime graph transitively by the family .Lifecycle
         contributions → their .Application projects (whose IFamilyHostModule + endpoints reference the
         minimal-API types). The lifecycle host is NOT a web app — it never maps an endpoint; the .Application
         assemblies ride along only for the Npgsql read-model store classes the family .Lifecycle modules bind
         (Postgres{Deposit,InstallmentCalendar}ReadModelStore). Declared explicitly so the Worker host resolves
         the framework those transitive references require.
         The shared framework already provides Host.CreateApplicationBuilder (Microsoft.Extensions.Hosting) and
         AddHttpClient (Microsoft.Extensions.Http), so no explicit PackageReference to either is needed (an
         explicit one would be redundant — NU1510). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenTelemetry SDK + OTLP exporter (ADR-IC-007 Layer 1), the same two packages the notification host
         brings: AddOpenTelemetry/ConfigureResource/WithTracing/WithLogging (Extensions.Hosting) and the OTLP
         exporter. The SDK is wired only in the runnable host, never the extraction-ready cores. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK-free shared telemetry LEAF (ADR-PC-019 §P2): BabelstoneResource (the OBS-1 resource stamp),
         the babelstone.* attribute contract, and the shared Babelstone.Engine ActivitySource the host registers
         and turns on. Referenced by the runnable host exactly as the notification host references it. -->
    <ProjectReference Include="../../../engine/src/Babelstone.Telemetry/Babelstone.Telemetry.csproj" />

    <!-- The telemetry HOSTING seam: AddBabelstonePiiGuard (the runtime emit-time no-PII guard, OBS-3), wired on
         both the trace and log pipelines above. Host-only, carrying no engine-kernel or family path. -->
    <ProjectReference Include="../../../engine/src/Babelstone.Telemetry.Hosting/Babelstone.Telemetry.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The lifecycle-command driver CORE (the per-tick pass, the dispatch ledger, the command-POST sink, the
         family-rule + module ports IFamilyLifecycleModule / ILifecycleCommandRule + LifecycleModuleContext, and
         the clock-owning LifecycleWorker). The host composes it; the core never references back and names no
         family. -->
    <ProjectReference Include="../Babelstone.Lifecycle/Babelstone.Lifecycle.csproj" />

    <!-- The shared CADENCE poll-loop machinery (ADR-PC-036 §Decision 2 + ADR-IC-019 mechanism reuse).
         Already reachable transitively (the core references Babelstone.Cadence); named explicitly because
         host code uses its types directly (CadenceSchedulerOptions in Program.cs). -->
    <ProjectReference Include="../../../cadence/src/Babelstone.Cadence/Babelstone.Cadence.csproj" />

    <!-- The shared generic FamilyModuleScanner (ADR-PC-040 §D4) this host's module loader delegates
         its discovery mechanics to — its own tiny assembly (composition/), separate from the Cadence
         poll-loop library above. -->
    <ProjectReference Include="../../../composition/src/Babelstone.Composition/Babelstone.Composition.csproj" />

    <!-- The family .Lifecycle CONTRIBUTIONS (ADR-PC-036 §Decision 2/5; ADR-PC-021 §A3/§P4): each carries its
         family's IFamilyLifecycleModule + rule + the Npgsql read-model store the module binds behind the
         family-agnostic store interface. Referenced ONLY so their Babelstone.Families.*.Lifecycle.dll land
         beside the host in the output dir, where LifecycleModuleLoader's base-directory probe discovers them by
         assembly-scan — the host's Program.cs names NO type from them (so the compiler elides these from the IL
         reference graph; the ProjectReference still copies the dll). Adding a clock-driven lifecycle to a new
         family is a new .Lifecycle ProjectReference here + its module — no Program.cs edit (ADR-PC-036 §S4). -->
    <ProjectReference Include="../../../families/term-deposit/src/Babelstone.Families.TermDeposit.Lifecycle/Babelstone.Families.TermDeposit.Lifecycle.csproj" />
    <ProjectReference Include="../../../families/personal-loan/src/Babelstone.Families.PersonalLoan.Lifecycle/Babelstone.Families.PersonalLoan.Lifecycle.csproj" />
  </ItemGroup>
</Project>
