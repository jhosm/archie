<Project>
  <!-- NuGet Central Package Management (bhq.15). Every dependency version is declared
       once here; individual .csproj files carry version-less <PackageReference>s.
       MSBuild discovers this file by walking up the physical directory tree from each
       project, like Directory.Build.props — placed at the REPO ROOT so it reaches both
       engine/src/** and the sibling families/term-deposit/** tree (an engine/-level file
       would miss families/). A version bump is now a one-line edit here.
       Per-project metadata (PrivateAssets, IncludeAssets) stays on the PackageReference;
       use VersionOverride= on a PackageReference if a project ever needs a different pin. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn surface for the Money/Engine analysers (and their test harnesses). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />

    <!-- PostgreSQL data access (EventStore, RateSheets, migrations). -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />

    <!-- Test toolchain: runner, assertions, property-based testing, integration containers. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.3.3" />
    <PackageVersion Include="Testcontainers" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />

    <!-- In-process ASP.NET Core host for the rate-sheet deploy endpoint tests. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
  </ItemGroup>
</Project>
