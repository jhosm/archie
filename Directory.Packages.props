<Project>
  <!-- NuGet Central Package Management (bhq.15). Every dependency version is declared
       once here; individual .csproj files carry version-less <PackageReference>s.
       MSBuild discovers this file by walking up the physical directory tree from each
       project, like Directory.Build.props — placed at the REPO ROOT so it reaches both
       engine/src/** and the sibling families/term-deposit/** tree (an engine/-level file
       would miss families/). A version bump is now a one-line edit here.
       Per-project metadata (PrivateAssets, IncludeAssets) stays on the PackageReference;
       use VersionOverride= on a PackageReference if a project ever needs a different pin. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn surface for the Money/Engine analysers (and their test harnesses). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />

    <!-- PostgreSQL data access (EventStore, RateSheets, migrations). -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />

    <!-- Outbox→Redpanda relay + Avro codec (Epic E.4, babelstone-g7a7). Confluent.Kafka
         is the producer/consumer; Confluent.SchemaRegistry resolves schema ids; Apache.Avro
         builds GenericRecords + serializes the value bytes. These stay OUT of
         Babelstone.EventStore (Npgsql-only) — they live in Babelstone.Engine.Avro and
         Babelstone.OutboxPublisher (event-store-skeleton §5.4 / §2.1). -->
    <PackageVersion Include="Confluent.Kafka" Version="2.15.0" />
    <PackageVersion Include="Confluent.SchemaRegistry" Version="2.15.0" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Avro" Version="2.15.0" />
    <PackageVersion Include="Apache.Avro" Version="1.12.1" />
    <!-- IHostedService/BackgroundService host for the relay's poll loop. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- IHttpClientFactory for the saga command dispatcher (bd babelstone-t7o3.3, ADR-PC-029): the
         dispatcher drains saga_outbox and delivers each command to the engine over idempotent HTTP.
         The factory owns connection pooling/lifetime; the orchestrator stays extraction-ready
         (ADR-PC-019 §P2) — this is a leaf Microsoft.Extensions package, NOT an engine-kernel ref. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <!-- ILogger / EventId for the shared structured-log event-id contract (ADR-IC-007 Layer 1):
         the abstractions only — Babelstone.Telemetry stays backend-/hosting-free, the hosts bring
         the logging implementation. The same 10.0.8 line as the other Microsoft.Extensions pins. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />

    <!-- IConfiguration for the application-credential secret boundary (ADR-PC-004 Amendment A1):
         Abstractions for Babelstone.Pii's ConfigurationSecretProvider; the full package for the
         in-memory provider its unit tests build. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.10" />

    <!-- Test toolchain: runner, assertions, property-based testing, integration containers. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.3.4" />
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <!-- WireMock.Net (bd babelstone-t7o3.4): the in-process Core-ACL settlement stub the saga command
         DISPATCHER targets at v1 (the real ACL is DEF-1, bd ub9s). The gated-settlement integration
         test stands up a WireMock server with success + InsufficientBalance/refusal mappings for the
         settlement endpoints and points the dispatcher's SettlementBaseUrl at it — a TEST-only
         dependency that does NOT widen the runtime orchestrator graph (ADR-PC-019 §P2). -->
    <PackageVersion Include="WireMock.Net" Version="2.14.0" />
    <!-- PactNet (ADR-IC-009): the FORMAL Pact CDC harness for the notify emit contract — the
         notification-delivery consumer's message pact + the engine-side producer verification, both
         TEST-only (never a runtime dependency). Pinned to the 4.5 line DELIBERATELY: PactNet 5.0.x
         ships a libpact_ffi regression that breaks message-pact PRODUCER verification with
         "builder error for url (message://...)" (pact-foundation/pact-net#530); 4.5.0's bundled FFI
         predates it and both halves run green. -->
    <PackageVersion Include="PactNet" Version="4.5.0" />
    <!-- Line/branch code-coverage collector (Q.y, babelstone-2t16.13). Each *.Tests.csproj
         carries a version-less <PackageReference Include="coverlet.collector"> with
         PrivateAssets="all" (a build-time-only collector, never shipped). CI collects via
         the XPlat VSTest data collector ("dotnet test" with the "XPlat Code Coverage" data
         collector) which writes a per-project cobertura.xml; the legacy "dotnet-coverage
         collect" (CLR-profiler) route silently emits an empty line-rate=1 report on
         macOS/.NET 10 ("Profiler was not initialized"), so the collector is the one we use.
         The per-project reports are stitched with "dotnet-coverage merge" into one report. -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />

    <!-- In-process ASP.NET Core host for the rate-sheet deploy endpoint tests. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />

    <!-- YAML parser for the in-engine pack loader (ADR-PC-007 §S2, Babelstone.Packs). -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />

    <!-- OpenTelemetry (ADR-IC-007 Layer 1, Epic K.1). OpenTelemetry.Api carries only the
         System.Diagnostics ActivitySource surface — it lives in Babelstone.Telemetry and the
         engine spine. The SDK (Extensions.Hosting for AddOpenTelemetry/ConfigureResource and
         the OTLP exporter) is wired only in the two HTTP hosts; the core OpenTelemetry package
         backs the in-memory span fitness test. One pinned 1.x line across all four. -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <!-- In-memory metric/span exporter (test-only): backs the Docker-free K.5 fitness test
         (bd scd2.3) that asserts the Npgsql db.client.operation.duration histogram flows through a
         provider built via the shared instrumentation seam. Same pinned 1.16.0 line; referenced only
         by Babelstone.Telemetry.Hosting.Tests, never by a host. -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.17.0" />
    <!-- ASP.NET Core inbound-request instrumentation (ADR-IC-007 Layer 1, bd babelstone-2dex):
         turns each inbound HTTP request into a SERVER span that adopts the W3C traceparent when
         present, so the engine's manual deposit.* spans nest under it instead of being roots.
         Wired only in Babelstone.Engine.Api (the engine command/query host). Its own 1.15.x line,
         the latest tracking the 1.16.0 core. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <!-- Npgsql's BUILT-IN OpenTelemetry instrumentation (ADR-IC-007 Layer 1, bd scd2.3 / K.5):
         AddNpgsql() on the TracerProvider emits a CLIENT span per database command, and
         AddNpgsqlInstrumentation() on the MeterProvider emits the stable OTel
         db.client.operation.duration histogram — across EVERY engine Postgres call (event-store
         appends, outbox drain + lag observer, projection/checkpoint stores), because they all run
         on plain NpgsqlConnection/NpgsqlCommand which this instrumentation hooks globally. It is
         registered on the SAME provider the hosts already configure (never a second, parallel one).
         Pinned to the Npgsql 10.0.3 line so the instrumentation tracks the driver exactly. The
         AddNpgsql/AddNpgsqlInstrumentation extensions live in the host-only Babelstone.Telemetry.Hosting
         seam, keeping the engine-spine-referenced Babelstone.Telemetry SDK-free. -->
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>
</Project>
