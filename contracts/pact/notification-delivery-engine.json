{
  "consumer": {
    "name": "notification-delivery"
  },
  "messages": [
    {
      "contents": {
        "causation_id": "5e8d7c1d-9a3e-4b2f-8a2c-3d5a7b9c1f0e",
        "customer_id": "7c1d9a3e-5b2f-4e8d-9c6a-1f0e3d5a7b9c",
        "data": {
          "maturity_date": "2026-09-01",
          "principal_cents": "1000000"
        },
        "due_at": "2026-09-01",
        "instance_id": "2b6f2e8c-6f9d-4b7e-8a2c-9d1e0f3a5b7c",
        "notification_id": "018f3c1a-2f66-7c3e-9c9a-5b8f0d9e4a01",
        "template_pack_version": "pt.2026.1",
        "template_ref": "pt.notice.maturity",
        "trigger_kind": "EVENT_DRIVEN"
      },
      "description": "a NotificationDue message for a matured term deposit",
      "matchingRules": {
        "body": {
          "$.causation_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            ]
          },
          "$.customer_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            ]
          },
          "$.data.maturity_date": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            ]
          },
          "$.data.principal_cents": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^[0-9]+$"
              }
            ]
          },
          "$.due_at": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            ]
          },
          "$.instance_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            ]
          },
          "$.notification_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            ]
          },
          "$.template_pack_version": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.template_ref": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "a term deposit matured with a notification obligation"
        }
      ]
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.0",
      "models": "1.0.4"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "engine"
  }
}