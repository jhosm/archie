{
  "type": "record",
  "namespace": "loans.credito_pessoal",
  "name": "LoanDisbursed",
  "doc": "The loan is disbursed: the lump-sum principal is paid out and the closed-end French-system amortization schedule is fixed at constitution (fin-math §4.1). The closed-end-asset analogue of term_deposit.DepositConstituted. Business payload only (ADR-IC-002 §P5); CloudEvents envelope rides in Kafka headers, NOT here. No PII (ADR-PC-004 §P2). Origination stays upstream (ADR-PC-030 / ADR-PC-024) — the loan arrives already approved and priced.",
  "fields": [
    { "name": "loan_id", "type": { "type": "string", "logicalType": "uuid" }, "doc": "LoanId (Guid)." },
    { "name": "principal_cents", "type": "long", "doc": "Disbursed capital (lump sum) as integer EUR cents (Money.Cents, ADR-PC-010 §P1)." },
    { "name": "tan_basis_points", "type": "int", "doc": "Annual nominal rate (TAN) in basis points, resolved from the rate sheet at constitution." },
    { "name": "rate_sheet_version_id", "type": "string", "doc": "The pinned rate-sheet version the TAN was resolved from." },
    { "name": "term_months", "type": "int", "doc": "Number of monthly installments the loan amortizes over." },
    { "name": "periodic_rate_basis_points", "type": "int", "doc": "The periodic (monthly) rate the schedule amortizes at, in basis points (TAN_bps / 12, the PT proportional-rate convention, fin-math §2.2)." },
    { "name": "installment_amount_cents", "type": "long", "doc": "The level (constant) installment the borrower pays each period as integer EUR cents (P = C × r / (1 − (1 + r)^−n), fin-math §4.1)." },
    { "name": "start_date", "type": { "type": "int", "logicalType": "date" }, "doc": "Disbursement date (schedule anchor) as days since epoch." },
    { "name": "first_installment_date", "type": { "type": "int", "logicalType": "date" }, "doc": "Due date of the first installment (start_date + one cadence) as days since epoch." },
    { "name": "purpose", "type": "string", "doc": "The loan purpose category (e.g. general, education, health) — selects the legal TAEG ceiling bucket (research/credito-pessoal/02 §2). Structural, NOT PII (ADR-PC-004 §P2)." },
    { "name": "product_code", "type": "string", "doc": "The catalogue product code the rate sheet priced — the structural product identifier. NOT PII (ADR-PC-004 §P2)." },
    { "name": "disbursement_account", "type": "string", "doc": "An OPAQUE disbursement-account TOKEN — a REFERENCE the engine resolves internally, NEVER an IBAN/cleartext identifier (ADR-PC-004 §P2). The account the lump sum was credited to." },
    { "name": "early_repayment_commission_bps", "type": "int", "default": 0, "doc": "The early-repayment commission the product charges, in basis points, PINNED at constitution (ADR-PC-009). The capped early-repayment commission a later early repayment charges resolves from this (fin-math §7.5). 0 ⇒ no commission. Additive with a default so pre-field records still decode (forward-only schema evolution, ADR-IC-002 §P3)." }
  ]
}
