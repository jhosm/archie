{
  "type": "record",
  "namespace": "loans.personal_loan",
  "name": "LoanDisbursed",
  "doc": "The loan is disbursed: the lump-sum principal is paid out and the closed-end French-system amortization schedule is fixed at constitution (fin-math §4.1). The closed-end-asset analogue of term_deposit.DepositConstituted. Business payload only (ADR-IC-002 §P5); CloudEvents envelope rides in Kafka headers, NOT here. No PII (ADR-PC-004 §P2). Origination stays upstream (ADR-PC-030 / ADR-PC-024) — the loan arrives already approved and priced.",
  "fields": [
    { "name": "loan_id", "type": { "type": "string", "logicalType": "uuid" }, "doc": "LoanId (Guid)." },
    { "name": "principal_cents", "type": "long", "doc": "Disbursed capital (lump sum) as integer EUR cents (Money.Cents, ADR-PC-010 §P1)." },
    { "name": "tan_basis_points", "type": "int", "doc": "Annual nominal rate (TAN) in basis points, resolved from the rate sheet at constitution." },
    { "name": "rate_sheet_version_id", "type": "string", "doc": "The pinned rate-sheet version the TAN was resolved from." },
    { "name": "term_months", "type": "int", "doc": "Number of monthly installments the loan amortizes over." },
    { "name": "periodic_rate_basis_points", "type": "int", "doc": "The periodic (monthly) rate the schedule amortizes at, in basis points (TAN_bps / 12, the PT proportional-rate convention, fin-math §2.2)." },
    { "name": "installment_amount_cents", "type": "long", "doc": "The level (constant) installment the borrower pays each period as integer EUR cents (P = C × r / (1 − (1 + r)^−n), fin-math §4.1)." },
    { "name": "start_date", "type": { "type": "int", "logicalType": "date" }, "doc": "Disbursement date (schedule anchor) as days since epoch." },
    { "name": "first_installment_date", "type": { "type": "int", "logicalType": "date" }, "doc": "Due date of the first installment (start_date + one cadence) as days since epoch." },
    { "name": "purpose", "type": "string", "doc": "The loan purpose category (e.g. general, education, health) — selects the legal TAEG ceiling bucket (research/personal-loan/02 §2). Structural, NOT PII (ADR-PC-004 §P2)." },
    { "name": "product_code", "type": "string", "doc": "The catalogue product code the rate sheet priced — the structural product identifier. NOT PII (ADR-PC-004 §P2)." },
    { "name": "disbursement_account_ref", "type": "string", "doc": "An OPAQUE disbursement-account TOKEN — a REFERENCE the engine resolves internally, NEVER an IBAN/cleartext identifier (ADR-PC-004 §P2). The account the lump sum was credited to." },
    { "name": "early_repayment_commission_bps", "type": "int", "default": 0, "doc": "The early-repayment commission the product charges, in basis points, PINNED at constitution (ADR-PC-009). The capped early-repayment commission a later early repayment charges resolves from this (fin-math §7.5). 0 ⇒ no commission. Additive with a default so pre-field records still decode (forward-only schema evolution, ADR-IC-002 §P3)." },
    { "name": "movements", "type": { "type": "array", "items": {
      "type": "record",
      "name": "Movement",
      "doc": "One recorded change of value against a single engine-owned account (ADR-PC-032), carried append-first inside this event. Inlined verbatim from the governed carrier shape contracts/avro/_shared/Movement.avsc.json — a disbursement records ONE Originated Credit Movement against disbursement_account_ref (the lump sum ENTERS that account; ADR-PC-032 §A8 / feature-design §134). The substrate-owned settlement saga effects the cash leg, gated, off the promoted ce_movementorigin / ce_movementdirections headers; the engine no longer settles eagerly on the append path.",
      "fields": [
        { "name": "account_ref", "type": "string", "doc": "The engine-owned account the value moves against — an OPAQUE token the engine resolves internally, NEVER an IBAN/cleartext or ciphertext PII identifier (ADR-PC-004 §P2). References are allowed on the bus; PII is not." },
        { "name": "direction", "type": { "type": "enum", "name": "MovementDirection", "symbols": ["Debit", "Credit"] }, "doc": "Debit | Credit, ALWAYS relative to account_ref: Debit = value leaves that account, Credit = value enters it (feature-design §2). (SettlementDirection on the C# side.)" },
        { "name": "amount_cents", "type": "long", "doc": "The amount moved as integer EUR cents (Money.Cents, ADR-PC-010 §P1). The engine never expresses money as a float." },
        { "name": "value_date", "type": { "type": "int", "logicalType": "date" }, "doc": "The economic date the value moves (valid_time) as days since epoch — never wall-clock (ADR-PC-032 slot 1)." },
        { "name": "operation", "type": { "type": "enum", "name": "MovementOperation", "symbols": ["Disburse", "CollectInstallment", "PayMaturity", "PayCoupon", "PayEarlyTermination", "RepayEarly", "RolloverDebit"] }, "doc": "The CLOSED engine-side operation code naming WHICH money move this is (ADR-PC-032 slot 1) — an enum, NOT a free string. The settlement leg maps it to the ACL operation_type half of the idempotency key (ADR-IC-012 §P4). Widen forward-only by ADDING a symbol at the END (ADR-IC-002)." },
        { "name": "origin", "type": { "type": "enum", "name": "MovementOrigin", "symbols": ["Originated", "Observed"] }, "doc": "Who initiated the movement and what the spine does next (ADR-PC-032 slot 2). Originated = the decider decided it, so its cash leg is effected by the gated settlement leg. Observed = it arrived already cleared (no cash leg). A disbursement is Originated." },
        { "name": "command_id", "type": { "type": "string", "logicalType": "uuid" }, "doc": "The ADR-PC-029 append-idempotency CommandId the originating command carried, threaded on for append idempotency + correlation (ADR-PC-032 slot 4)." }
      ]
    } }, "default": [], "doc": "The disbursement's money movement(s) recorded append-first (ADR-PC-032 slot 5). A REQUIRED array (an event with no movements carries an EMPTY array, never null) defaulted to [] so pre-Movement records still decode (forward-only schema evolution, ADR-IC-002 §P3 / BACKWARD compat). The engine's family-agnostic codec (MovementCarrier) binds this to LoanDisbursed's IReadOnlyList<Movement>; the promoted ce_movementorigin / ce_movementdirections headers auto-start the substrate settlement saga." }
  ]
}
