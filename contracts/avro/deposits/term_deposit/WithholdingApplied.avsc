{
  "type": "record",
  "namespace": "deposits.term_deposit",
  "name": "WithholdingApplied",
  "doc": "Withholding tax applied flow-by-flow to the gross interest, with Net = Gross - Tax conserved to the cent. Business payload only (ADR-IC-002 §P5); no PII (ADR-PC-004 §P2).",
  "fields": [
    { "name": "tax_cents", "type": "long", "doc": "Withholding Tax as integer EUR cents (Money.Cents)." },
    { "name": "net_cents", "type": "long", "doc": "Net interest as integer EUR cents (Money.Cents)." }
  ]
}
