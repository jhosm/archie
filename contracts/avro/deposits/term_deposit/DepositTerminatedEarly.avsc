{
  "type": "record",
  "namespace": "deposits.term_deposit",
  "name": "DepositTerminatedEarly",
  "doc": "The deposit is broken before maturity and settled net of the configured penalty (02 §2.5): NetSettlementAmount = PrincipalReturned + NetAccruedInterest − PenaltyAmount (the accrued NET interest is settled back; only the penalty is forfeited). PROMOTED to an integration event (bd t7o3.13/t7o3.13.1) so the early-termination payout's Movement reaches the substrate-owned settlement saga off the bus — the gated ACL credit replaces the old eager settle (ADR-PC-032 slot 5 / ADR-IC-017 §P4). Business payload only (ADR-IC-002 §P5); CloudEvents envelope rides in Kafka headers, NOT here. No PII (ADR-PC-004 §P2): deposit_id is an opaque reference, never depositor identity.",
  "fields": [
    { "name": "deposit_id", "type": { "type": "string", "logicalType": "uuid" }, "doc": "DepositId (Guid) — an opaque aggregate reference, NOT depositor identity (ADR-PC-004 §P2)." },
    { "name": "principal_returned_cents", "type": "long", "doc": "PrincipalReturned as integer EUR cents (Money.Cents, ADR-PC-010 §P1) — the principal still on deposit at the break." },
    { "name": "penalty_amount_cents", "type": "long", "doc": "PenaltyAmount as integer EUR cents (Money.Cents) — the EFFECTIVE penalty actually charged (after the floor), non-negative." },
    { "name": "net_settlement_amount_cents", "type": "long", "doc": "NetSettlementAmount as integer EUR cents (Money.Cents) = principal_returned + net_accrued_interest − penalty_amount, conserved to the cent." },
    { "name": "terminated_on", "type": { "type": "int", "logicalType": "date" }, "doc": "TerminatedOn (DateOnly) as days since epoch — the as-of break date." },
    { "name": "termination_reason", "type": "string", "doc": "A stable, non-PII reason code (e.g. CUSTOMER_REQUEST) — never anything about the customer (ADR-PC-004 §P2)." },
    { "name": "movements", "type": { "type": "array", "items": {
      "type": "record",
      "name": "Movement",
      "doc": "One recorded change of value against a single engine-owned account (ADR-PC-032), carried append-first inside this event. Inlined verbatim from the governed carrier shape contracts/avro/_shared/Movement.avsc.json — an early termination records ONE Originated Credit Movement against the payout account (the net settlement ENTERS that account; ADR-PC-032 §A8). CONFIRMATION-gated, not funds-gated (ADR-PC-016 slot 5). The substrate-owned settlement saga effects the cash leg, gated, off the promoted ce_movementorigin / ce_movementdirections headers; the engine no longer settles eagerly on the append path (bd t7o3.13).",
      "fields": [
        { "name": "account_ref", "type": "string", "doc": "The engine-owned account the value moves against — an OPAQUE token the engine resolves internally, NEVER an IBAN/cleartext or ciphertext PII identifier (ADR-PC-004 §P2). References are allowed on the bus; PII is not." },
        { "name": "direction", "type": { "type": "enum", "name": "MovementDirection", "symbols": ["Debit", "Credit"] }, "doc": "Debit | Credit, ALWAYS relative to account_ref: Debit = value leaves that account, Credit = value enters it (feature-design §2). (SettlementDirection on the C# side.)" },
        { "name": "amount_cents", "type": "long", "doc": "The amount moved as integer EUR cents (Money.Cents, ADR-PC-010 §P1). The engine never expresses money as a float." },
        { "name": "value_date", "type": { "type": "int", "logicalType": "date" }, "doc": "The economic date the value moves (valid_time) as days since epoch — never wall-clock (ADR-PC-032 slot 1)." },
        { "name": "operation", "type": { "type": "enum", "name": "MovementOperation", "symbols": ["Disburse", "CollectInstallment", "PayMaturity", "PayCoupon", "PayEarlyTermination", "RepayEarly", "RolloverDebit"] }, "doc": "The CLOSED engine-side operation code naming WHICH money move this is (ADR-PC-032 slot 1) — an enum, NOT a free string. The settlement leg maps it to the ACL operation_type half of the idempotency key (ADR-IC-012 §P4). Widen forward-only by ADDING a symbol at the END (ADR-IC-002)." },
        { "name": "origin", "type": { "type": "enum", "name": "MovementOrigin", "symbols": ["Originated", "Observed"] }, "doc": "Who initiated the movement and what the spine does next (ADR-PC-032 slot 2). Originated = the decider decided it, so its cash leg is effected by the gated settlement leg. Observed = it arrived already cleared (no cash leg). An early-termination payout is Originated." },
        { "name": "command_id", "type": { "type": "string", "logicalType": "uuid" }, "doc": "The ADR-PC-029 append-idempotency CommandId the originating command carried, threaded on for append idempotency + correlation (ADR-PC-032 slot 4). For the early-termination money-mover endpoint (bd t7o3.13.1) this is the request's Idempotency-Key; empty (all-zero) for a direct caller that supplies none." }
      ]
    } }, "default": [], "doc": "The early-termination payout's money movement(s) recorded append-first (ADR-PC-032 slot 5; bd t7o3.13/t7o3.13.1). A REQUIRED array (an event with no movements carries an EMPTY array, never null) defaulted to [] so pre-Movement records still decode (forward-only schema evolution, ADR-IC-002 §P3 / BACKWARD compat). The engine's family-agnostic codec (MovementCarrier) binds this to DepositTerminatedEarly's IReadOnlyList<Movement>; the promoted ce_movementorigin / ce_movementdirections headers auto-start the substrate settlement saga." }
  ]
}
