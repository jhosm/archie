{
  "type": "record",
  "namespace": "deposits.term_deposit",
  "name": "DepositMatured",
  "doc": "The deposit matures and pays out: TotalPayout = Principal + NetInterest. Business payload only (ADR-IC-002 §P5); no PII (ADR-PC-004 §P2).",
  "fields": [
    { "name": "principal_returned_cents", "type": "long", "doc": "PrincipalReturned as integer EUR cents (Money.Cents)." },
    { "name": "net_interest_paid_cents", "type": "long", "doc": "NetInterestPaid as integer EUR cents (Money.Cents)." },
    { "name": "total_payout_cents", "type": "long", "doc": "TotalPayout as integer EUR cents (Money.Cents)." },
    { "name": "matured_on", "type": { "type": "int", "logicalType": "date" }, "doc": "MaturedOn (DateOnly) as days since epoch." },
    { "name": "auto_renewal_policy", "type": ["null", "string"], "default": null, "doc": "Renewal policy (NONE/SAME_TERM_CURRENT_RATE/SAME_TERM_SAME_RATE), folded from DepositConstituted. Null for pre-field streams (BACKWARD-compatible additive field, ADR-IC-002 §P2). A structural enum token, not PII (ADR-PC-004 §P2). Promoted to the ce_autorenewalpolicy CloudEvents extension header by the outbox relay (ADR-IC-018 §P5)." },
    { "name": "movements", "type": { "type": "array", "items": {
      "type": "record",
      "name": "Movement",
      "doc": "One recorded change of value against a single engine-owned account (ADR-PC-032), carried append-first inside this event. Inlined verbatim from the governed carrier shape contracts/avro/_shared/Movement.avsc.json — a maturity records ONE Originated Credit Movement against the payout account (the payout ENTERS that account; ADR-PC-032 §A8). CONFIRMATION-gated, not funds-gated (ADR-PC-016 slot 5). The substrate-owned settlement saga effects the cash leg, gated, off the promoted ce_movementorigin / ce_movementdirections headers; the engine no longer settles eagerly on the append path (bd t7o3.13).",
      "fields": [
        { "name": "account_ref", "type": "string", "doc": "The engine-owned account the value moves against — an OPAQUE token the engine resolves internally, NEVER an IBAN/cleartext or ciphertext PII identifier (ADR-PC-004 §P2). References are allowed on the bus; PII is not." },
        { "name": "direction", "type": { "type": "enum", "name": "MovementDirection", "symbols": ["Debit", "Credit"] }, "doc": "Debit | Credit, ALWAYS relative to account_ref: Debit = value leaves that account, Credit = value enters it (feature-design §2). (SettlementDirection on the C# side.)" },
        { "name": "amount_cents", "type": "long", "doc": "The amount moved as integer EUR cents (Money.Cents, ADR-PC-010 §P1). The engine never expresses money as a float." },
        { "name": "value_date", "type": { "type": "int", "logicalType": "date" }, "doc": "The economic date the value moves (valid_time) as days since epoch — never wall-clock (ADR-PC-032 slot 1)." },
        { "name": "operation", "type": { "type": "enum", "name": "MovementOperation", "symbols": ["Disburse", "CollectInstallment", "PayMaturity", "PayCoupon", "PayEarlyTermination", "RepayEarly", "RolloverDebit"] }, "doc": "The CLOSED engine-side operation code naming WHICH money move this is (ADR-PC-032 slot 1) — an enum, NOT a free string. The settlement leg maps it to the ACL operation_type half of the idempotency key (ADR-IC-012 §P4). Widen forward-only by ADDING a symbol at the END (ADR-IC-002)." },
        { "name": "origin", "type": { "type": "enum", "name": "MovementOrigin", "symbols": ["Originated", "Observed"] }, "doc": "Who initiated the movement and what the spine does next (ADR-PC-032 slot 2). Originated = the decider decided it, so its cash leg is effected by the gated settlement leg. Observed = it arrived already cleared (no cash leg). A maturity payout is Originated." },
        { "name": "command_id", "type": { "type": "string", "logicalType": "uuid" }, "doc": "The ADR-PC-029 append-idempotency CommandId the originating command carried, threaded on for append idempotency + correlation (ADR-PC-032 slot 4). Empty (all-zero) for the one-shot lifecycle commands that carry no command id (their idempotency rides the lifecycle gate + the stable process-id-derived external reference)." }
      ]
    } }, "default": [], "doc": "The maturity payout's money movement(s) recorded append-first (ADR-PC-032 slot 5; bd t7o3.13). A REQUIRED array (an event with no movements carries an EMPTY array, never null) defaulted to [] so pre-Movement records still decode (forward-only schema evolution, ADR-IC-002 §P3 / BACKWARD compat). The engine's family-agnostic codec (MovementCarrier) binds this to DepositMatured's IReadOnlyList<Movement>; the promoted ce_movementorigin / ce_movementdirections headers auto-start the substrate settlement saga." }
  ]
}
