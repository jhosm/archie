{
  "type": "record",
  "namespace": "operations",
  "name": "NotificationDeliveryExhausted",
  "doc": "Webhook delivery of one customer notification gave up for good: the notification service's delivery outbox retried the §D4 backoff schedule to exhaustion (10 attempts, ~12h) and dead-lettered the record — this event is the backbone announcement of that fact (ADR-IC-011 §D4/§P3 step 7). Produced by the NOTIFICATION service's own exhausted-event outbox (ADR-IC-004 discipline: the row is written in the SAME transaction as the DEAD_LETTERED flip), NEVER by the engine — the producing flow behind the notification is long committed and unaffected (ADR-PC-025 slot 5, post-flag). Consumers are operational: an operator/alerting surface picks the notification up out of band; nothing retries off this event. Cross-cutting event under the synthetic `operations` aggregate_type (event-store §4.3). Business payload only (ADR-IC-002 §P5): the CloudEvents envelope rides in Kafka HEADERS, not here. NO PII — cleartext OR ciphertext (ADR-PC-004 §P2): customer_id is an opaque recipient REFERENCE; last_error carries transport-status diagnostics only (an HTTP status line, a timeout message), never payload or subject data.",
  "fields": [
    { "name": "notification_id", "type": { "type": "string", "logicalType": "uuid" }, "doc": "The exhausted delivery's stable composite idempotency key (ADR-PC-025 slot 4) — the SAME id every delivery attempt carried, so an operator can join this event to the NotificationDue signal and to the receiver's own dedupe log. One exhausted event exists per notification_id, ever. Structural, not PII." },
    { "name": "instance_id", "type": { "type": "string", "logicalType": "uuid" }, "doc": "InstanceId (Guid) — the instance (stream) the undelivered notification is about. partition_key = instance_id (per-instance order, the same keying as NotificationDue). Structural reference, not PII." },
    { "name": "customer_id", "type": ["null", { "type": "string", "logicalType": "uuid" }], "default": null, "doc": "The recipient REFERENCE the undelivered signal carried, when it carried one (the v1 SCHEDULED leg's signal carries none — a named residual of ADR-PC-025). Null-first union (ADR-IC-002 §P2). An opaque subject id, NEVER the name/NIF/contact itself (ADR-PC-004 §P2)." },
    { "name": "template_ref", "type": "string", "doc": "The pack-namespaced template the undelivered notification would have rendered (ADR-PC-007). Lets an operator judge the notice's materiality (a maturity notice vs a courtesy reminder) without dereferencing the delivery store. Structural, not PII." },
    { "name": "template_pack_version", "type": "string", "doc": "The pack version pinned on the undelivered signal (ADR-PC-007 / ADR-PC-009). Structural, not PII." },
    { "name": "trigger_kind", "type": { "type": "enum", "name": "NotificationTriggerKind", "doc": "Why the undelivered notification became due — the governed taxonomy of the engine-owned NotificationDue contract (ADR-PC-025 §6), carried through unchanged so the operational consumer can slice exhaustion by leg. Defined field-inline with the SAME name, symbols, and default as NotificationDue.avsc's — the two schemas are registered as independent subjects and each embeds its own copy.", "symbols": ["EVENT_DRIVEN", "SCHEDULED", "PRE_CONTRACTUAL"], "default": "EVENT_DRIVEN" }, "doc": "EVENT_DRIVEN | SCHEDULED | PRE_CONTRACTUAL (ADR-PC-025 §6) — the undelivered signal's trigger leg." },
    { "name": "causation_id", "type": ["null", { "type": "string", "logicalType": "uuid" }], "default": null, "doc": "The causing domain event the undelivered signal traced to — carried through from NotificationDue.causation_id unchanged, so an operator can walk from the exhaustion straight back to the fact that implied the notice (ADR-PC-023 traceability). Non-null for EVENT_DRIVEN; null for SCHEDULED (a date arriving has no causing domain event). Null-first union (ADR-IC-002 §P2). Structural reference, not PII." },
    { "name": "attempts", "type": "int", "doc": "Delivery attempts made before dead-lettering — the §D4 exhaustion count (10 under the default WebhookDeliveryOptions.MaxAttempts). Structural, not PII." },
    { "name": "last_error", "type": ["null", "string"], "default": null, "doc": "The final attempt's transport diagnostic — an HTTP status summary ('receiver answered 503') or a client-side failure message (timeout, connection refused). Null-first union (ADR-IC-002 §P2). Transport-status text only: NEVER the webhook payload, rendered content, or any subject data (ADR-PC-004 §P2)." },
    { "name": "exhausted_at", "type": { "type": "long", "logicalType": "timestamp-millis" }, "doc": "When the delivery store recorded the DEAD_LETTERED flip (DB clock, the same instant the exhausted-outbox row was written in the same transaction). Millis since epoch, UTC. Structural, not PII." }
  ]
}
