{
  "type": "record",
  "namespace": "operations",
  "name": "NotificationDue",
  "doc": "A customer notification of template `template_ref` is due for an instance, with the structural data to render it (ADR-PC-025). Engine-OWNED, engine-cross-cutting event under the synthetic `operations` aggregate_type (event-store §4.3) — the engine owns this schema and the `trigger_kind` taxonomy (ADR-PC-025 §6). The engine emits only EVENT_DRIVEN + PRE_CONTRACTUAL; the enum RETAINS SCHEDULED for a DOWNSTREAM producer — the family-agnostic notification scheduler (ADR-IC-019) reads the maturity-calendar / accrual projections and produces NotificationDue(SCHEDULED) itself, because the engine emits no clock-driven signal and runs no scheduler (ADR-PC-023). Business payload only (ADR-IC-002 §P5); the CloudEvents envelope (event_id, partition_key, valid_time/transaction_time, correlation_id) rides in Kafka HEADERS, NOT here. NO PII — cleartext OR ciphertext (ADR-PC-004 §P2): customer_id is an opaque recipient REFERENCE the communications system resolves at render time against the engine's PII-resolve surface (returning null for a crypto-shredded subject); `data` carries STRUCTURAL interpolation values only (amounts, dates, rates, TAE), never the subject's name, NIF, or contact data.",
  "fields": [
    { "name": "notification_id", "type": { "type": "string", "logicalType": "uuid" }, "doc": "The idempotency key (slot 4) — a composite of instance_id + template_ref + the triggering occurrence (causation_id for EVENT_DRIVEN; the schedule-occurrence for SCHEDULED), STABLE across outbox redelivery AND event-store replay, so a rebuild never re-notifies. Dedupe runs consumer-side (the communications system owns 'already delivered this one'). Structural, not PII." },
    { "name": "instance_id", "type": { "type": "string", "logicalType": "uuid" }, "doc": "InstanceId (Guid) — the instance (stream) this notification is about (e.g. a DepositId). partition_key = instance_id (per-instance order, slot 3). Structural reference, not PII." },
    { "name": "customer_id", "type": { "type": "string", "logicalType": "uuid" }, "doc": "The recipient REFERENCE (ADR-PC-025 Decision 1) — an opaque subject id the communications system resolves at render time for BOTH the delivery address and any template-body PII, via the engine-owned PII-resolve surface (ADR-PC-004 §P2; returns null for a crypto-shredded subject). NEVER the name/NIF/contact itself: no PII, cleartext or ciphertext, rides this event." },
    { "name": "template_ref", "type": "string", "doc": "The pack-namespaced template to render (e.g. pt.disclosure.fin, pt.notice.maturity). The pack owns the template and this namespace (ADR-PC-007). Structural, not PII." },
    { "name": "template_pack_version", "type": "string", "doc": "The pack version PINNED on the instance (ADR-PC-007 / ADR-PC-009) — a deposit constituted under pt.2026.1 keeps disclosing under that pack's templates even after a newer pack ships. Structural, not PII." },
    { "name": "trigger_kind", "type": { "type": "enum", "name": "NotificationTriggerKind", "doc": "Why the notification became due. The ENGINE emits only EVENT_DRIVEN (a domain event implies it) and PRE_CONTRACTUAL (the FIN record copy whose legal gate was discharged synchronously in the constitution saga — ADR-PC-025 'FIN is a saga step'). SCHEDULED is a valid schema value a DOWNSTREAM producer carries (the notification scheduler, ADR-IC-019), but the engine never emits it (ADR-PC-023). Marks notifications whose legal force, if any, was discharged elsewhere so no consumer mistakes the record copy for the gate.", "symbols": ["EVENT_DRIVEN", "SCHEDULED", "PRE_CONTRACTUAL"], "default": "EVENT_DRIVEN" }, "doc": "The trigger taxonomy (ADR-PC-025 §6) — EVENT_DRIVEN | SCHEDULED | PRE_CONTRACTUAL. SCHEDULED is downstream-produced only (ADR-PC-023)." },
    { "name": "causation_id", "type": ["null", { "type": "string", "logicalType": "uuid" }], "default": null, "doc": "The id of the causing domain event for EVENT_DRIVEN (every engine-emitted notification traces to a fact, ADR-PC-023). NULL for SCHEDULED — a downstream-produced temporal notification has no causing domain event (its occurrence is a date arriving, derived off a projection). Structural reference, not PII." },
    { "name": "data", "type": { "type": "map", "values": "string" }, "doc": "STRUCTURAL interpolation values only — amounts, dates, rates, TAE — keyed by template field name (ADR-PC-025 Decision 1). NO PII (ADR-PC-004 §P2): the renderer resolves the subject's name/NIF/contact at render time by customer_id reference, never from this bag. A self-describing string→string map keeps the contract template-agnostic; the no-PII obligation is on the producer." },
    { "name": "due_at", "type": { "type": "int", "logicalType": "date" }, "doc": "DueAt (DateOnly) as days since epoch = valid_time (ADR-PC-025 Decision 1) — the date the notification is due. Structural, not PII." }
  ]
}
