{
  "type": "record",
  "namespace": "deposits.term_deposit",
  "name": "InterestAccrued",
  "doc": "Interest accrued for the period. For AT_MATURITY this is the single flow at maturity. Business payload only (ADR-IC-002 §P5); no PII (ADR-PC-004 §P2).",
  "fields": [
    { "name": "gross_interest_cents", "type": "long", "doc": "GrossInterest as integer EUR cents (Money.Cents)." },
    { "name": "as_of", "type": { "type": "int", "logicalType": "date" }, "doc": "AsOf (DateOnly) as days since epoch." }
  ]
}
