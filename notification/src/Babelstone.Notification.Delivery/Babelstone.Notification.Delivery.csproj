<!-- The /notification DELIVERY half — the outbound webhook transport LIBRARY (bd babelstone-60n8.4 /
     babelstone-60n8.7). In plain terms: once the scheduler (or the engine, for event-driven notices) has
     decided a customer notification is due, THIS is the machinery that actually gets it to the
     customer-communications consumer — an ADR-IC-004 per-service outbox drained by an ADR-IC-011
     HMAC-SHA256-signed webhook client with at-least-once delivery, exponential backoff (±25% jitter),
     dead-lettering, and consumer-side dedupe anchored on the stable composite notification_id
     (ADR-PC-025 slot 4). ONE transport for BOTH legs, parameterised by trigger_kind: the SCHEDULED leg
     enqueues via the core's INotificationDeliverySink; the EVENT_DRIVEN leg drains an
     INotificationDueSource (the post-commit bus seam) into the SAME outbox and renders the
     instance-pinned pack template with render-time PII resolution (ADR-PC-025 §PII) before delivery.

     FAMILY-AGNOSTIC (ADR-IC-019 §D2/§P2, gated by NOTIFICATION_FAMILY_AGNOSTIC alongside the core): this
     library references neither the engine kernel nor any product family — it moves signals whose template
     refs and data maps are opaque strings. It reaches the engine only over the published HTTP PII-resolve
     surface (ADR-PC-025 §PII), never a compile-time kernel reference. Extraction-ready subtree
     (ADR-PC-019 §P2): carries its own copy of the shared engine build settings and depends only on
     framework/third-party packages + the notification core + the shared cadence machinery + the
     SDK-free telemetry name-contract leaf. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.Notification.Delivery</RootNamespace>
    <AssemblyName>Babelstone.Notification.Delivery</AssemblyName>

    <!-- Shared engine build settings (mirrors the notification core csproj; the notification subtree is
         extraction-ready per ADR-PC-019 §P2, so it carries its own copy rather than inheriting the
         engine's). Runtime pinned by ADR-IC-011 — .NET, the same language as the engine (ADR-PC-010). -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Doc COVERAGE is a docs concern, not a build gate (same stance as the notification core):
         CS1591/CS1573 suppressed, doc ROT (malformed XML, broken refs) still fails. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- BackgroundService (via the cadence worker base), IServiceCollection/IConfiguration (the
         composition extension), and ILogger — all surfaced through Microsoft.Extensions.Hosting
         (version pinned centrally via Directory.Packages.props). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- IHttpClientFactory for the outbound webhook client and the engine PII-resolve client
         (the same leaf package the orchestrator's saga command dispatcher uses — connection
         pooling/lifetime owned by the factory; no engine-kernel ref, ADR-PC-019 §P2). -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- The durable delivery store (ADR-IC-011): raw Npgsql against the notification estate's OWN
         PostgreSQL tables — the same driver-only posture as the engine's event store and the
         lifecycle driver's ledger; no ORM, no engine-spine reference. -->
    <PackageReference Include="Npgsql" />
    <!-- The exhaustion relay (ADR-IC-011): the NotificationDeliveryExhausted backbone producer.
         Confluent.Kafka is the byte producer, Confluent.SchemaRegistry resolves the subject's
         schema_id (register-if-absent, ADR-IC-002 walking-skeleton posture), Apache.Avro encodes the
         governed payload. THIRD-PARTY packages only — the wire plumbing is deliberately
         self-contained here (a small mirror of the engine's OutboxDrainer) because this subtree takes
         no engine-spine ProjectReference (ADR-IC-019, NOTIFICATION_FAMILY_AGNOSTIC). -->
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Confluent.SchemaRegistry" />
    <PackageReference Include="Apache.Avro" />
  </ItemGroup>

  <ItemGroup>
    <!-- The delivery tests drive the internal consume/commit seam (IByteMessageConsumer) that
         KafkaNotificationDueSource polls, so the poll/decode/deferred-commit behaviour is exercised
         with no broker — the same InternalsVisibleTo posture the engine's InboxConsumer takes. -->
    <InternalsVisibleTo Include="Babelstone.Notification.Delivery.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The delivery estate's OWN forward-only migration series (ADR-IC-011), embedded so a
         deployed binary carries its schema — the same discipline as the engine / orchestrator /
         lifecycle-driver migration sets. -->
    <EmbeddedResource Include="Migrations/Sql/*.sql" />
    <!-- The governed NotificationDeliveryExhausted schema (contracts/avro is the single source,
         ADR-IC-002): embedded so the relay serialises against the exact contract it publishes. -->
    <EmbeddedResource Include="../../../contracts/avro/operations/NotificationDeliveryExhausted.avsc"
                      Link="Contracts/NotificationDeliveryExhausted.avsc" />
    <!-- The governed NotificationDue schema (contracts/avro is the single source, ADR-IC-002):
         embedded so the EVENT_DRIVEN bus consumer (KafkaNotificationDueSource) DESERIALISES against
         the exact contract the engine publishes — the reader half of the same posture the exhausted
         relay uses for its producer schema (bd babelstone-60n8.7 / babelstone-60n8.11). -->
    <EmbeddedResource Include="../../../contracts/avro/operations/NotificationDue.avsc"
                      Link="Contracts/NotificationDue.avsc" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared CADENCE machinery (ADR-PC-036 §Decision 2 + ADR-IC-019 mechanism reuse): the delivery
         worker is a CadenceWorker subclass and the delivery pass is an ISchedulePass, so the outbox drain
         runs on the SAME proven clock-owning poll loop as the scheduler and the lifecycle driver. -->
    <ProjectReference Include="../../../cadence/src/Babelstone.Cadence/Babelstone.Cadence.csproj" />
    <!-- The family-agnostic notification CORE: this library implements its INotificationDeliverySink
         outbound port (the SCHEDULED-leg hand-off) and maps its RaisedReminder into the delivery signal.
         The arrow is delivery → core (one-way); the core never references back. -->
    <ProjectReference Include="../Babelstone.Notification/Babelstone.Notification.csproj" />
    <!-- The SDK-free telemetry NAME CONTRACT (ADR-IC-007): the shared meter and the
         BabelstoneAttributes/BabelstoneEvents strings the delivery metrics and the exhaustion relay's
         structured log ride on. A leaf library, not the engine kernel — the same reference the
         lifecycle driver's core takes for its metrics; NotificationFamilyAgnosticTests names the
         forbidden spine set and this is not in it. -->
    <ProjectReference Include="../../../engine/src/Babelstone.Telemetry/Babelstone.Telemetry.csproj" />
  </ItemGroup>
</Project>
