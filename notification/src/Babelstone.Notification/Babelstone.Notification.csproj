<!-- The /notification worker host (ADR-IC-011 runtime — .NET, stack-coherent with the engine;
     ADR-IC-013 in-house estate placement). A per-service OUTBOX worker (ADR-IC-004): a
     BackgroundService poll-loop host shell, NOT an HTTP API — so Microsoft.NET.Sdk.Worker
     (the IHostedService host, the same hosted-BackgroundService shape the engine's outbox relay
     and the orchestrator's consume loop use), NOT Microsoft.NET.Sdk.Web.

     This skeleton stands up the host + the ADR-PC-027 read-contract access only. There is NO
     scheduler timing and NO event emission yet — those are the downstream children
     (babelstone-60n8.2 / .3). The host carries no Confluent/outbox-publish surface yet; it will
     gain the emission leg with its own build task.

     FAMILY-AGNOSTIC (ADR-IC-019 §D2/§P2, bd babelstone-60n8.5): the notification core references
     neither the engine kernel (Babelstone.Engine / Babelstone.EventStore) nor any family — it reads
     deposit facts over the storage-opaque ADR-PC-027 HTTP contract (GET /v1/deposits/{id}), exactly
     as the orchestrator carries no engine kernel (ADR-IC-018 §S3). The NOTIFICATION_FAMILY_AGNOSTIC
     fitness gate parses this .csproj and fails the build on a families/** or engine-spine reference.
     Extraction-ready subtree (ADR-PC-019 §P2): the host carries its OWN copy of the shared engine
     build settings (it does not inherit engine/Directory.Build.props), as the orchestrator subtree
     does, and now lifts cleanly because it depends only on the SDK-free Telemetry leaf + framework
     packages — no engine-kernel or family path to drag along. -->
<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Babelstone.Notification</RootNamespace>
    <AssemblyName>Babelstone.Notification</AssemblyName>

    <!-- Shared engine build settings (mirrors the orchestrator host csproj; the notification
         subtree is extraction-ready per ADR-PC-019 §P2, so it carries its own copy rather than
         inheriting the engine's). Runtime pinned by ADR-IC-011 — .NET, the same language as the
         engine (ADR-PC-010 §.NET 10 LTS). -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Doc COVERAGE is a docs concern, not a build gate (same stance as the engine/orchestrator):
         CS1591/CS1573 suppressed, doc ROT (malformed XML, broken refs) still fails. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- BackgroundService/IHostedService + Host.CreateApplicationBuilder (the §5.1 worker host
         shell). The Microsoft.NET.Sdk.Worker normally adds this implicitly, but the repo-wide
         central package management (Directory.Packages.props, ManagePackageVersionsCentrally) means
         the implicit, version-less reference is pruned — so it is named explicitly here (version
         pinned centrally), the same way the orchestrator/OutboxPublisher hosts name their Hosting
         dependency. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- IHttpClientFactory + the typed-client registration (AddHttpClient<DepositReadClient>): the
         notification core reads deposit facts over the ADR-PC-027 HTTP contract (GET /v1/deposits/{id}),
         the same IHttpClientFactory pattern the orchestrator's dispatcher uses for its engine POSTs. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK-free shared telemetry LEAF (ADR-PC-019 §P2): BabelstoneResource (the OBS-1 resource
         contract — service.name/namespace/environment) + BabelstoneTelemetry (the shared
         ActivitySource the estate's spans share). Referenced DIRECTLY (not transitively via the engine
         kernel, which this host no longer references), exactly as the orchestrator host does — it is
         NOT one of the ADR-PC-021 §P2 spine projects, so NOTIFICATION_FAMILY_AGNOSTIC permits it. -->
    <ProjectReference Include="../../../engine/src/Babelstone.Telemetry/Babelstone.Telemetry.csproj" />

    <!-- The host-side OTel-SDK seam (ADR-IC-007 Layer 1): this composition root registers the
         TracerProvider + OTLP exporter so spans the host opens on the shared Babelstone ActivitySource
         (via the Telemetry leaf above) are created and exported to the Collector (§P1 — never
         direct-to-backend). Mirrors the engine API / orchestrator host wiring. Outbound HTTP-client
         CLIENT-span instrumentation lands with the scheduler/emission children that actually issue
         read calls on a clock (bd babelstone-60n8.2 / .3); this skeleton issues none. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
</Project>
