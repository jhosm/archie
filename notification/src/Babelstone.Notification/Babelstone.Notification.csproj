<!-- The /notification family-AGNOSTIC core LIBRARY (ADR-IC-019 §D2/§P1 + Amendment 2026-06-24). In
     plain terms: this is the part of the notification service that must never know what a term deposit
     is. It owns the generic poll-loop worker (NotificationWorker), the per-tick engine
     (NotificationSchedulePass), the composite-id primitive (NotificationId), the dedupe ledger, and the
     family-contribution port (IFamilyNotificationModule / INotificationScheduleRule). It does NOT own a
     deposit read client (a "deposit" is term-deposit knowledge, so the deposit-shaped read client is
     family-owned and lives in the family contribution, ADR-IC-019 D1). It is a LIBRARY, not the runnable
     host: the composition root that names families and wires OpenTelemetry lives in the sibling
     Babelstone.Notification.Host exe (the §A2/§D4 exemption holder).

     FAMILY-AGNOSTIC (ADR-IC-019 §D2/§P2, gated by NOTIFICATION_FAMILY_AGNOSTIC): this core references
     neither the engine kernel (Babelstone.Engine / Babelstone.EventStore) nor any product family — family
     scheduling rules + templates + their deposit-shaped read clients plug in through the port at the host
     edge and read family data over the storage-opaque ADR-PC-027 HTTP contract, never the byte store. The
     NotificationFamilyAgnosticTests
     gate parses this .csproj for a families/** or engine-spine reference AND scans this project's source for
     an embedded family literal (ADR-IC-019 §D2/§P2 + Amendment-A1). Extraction-ready subtree
     (ADR-PC-019 §P2): it carries its own copy of the shared engine build settings rather than inheriting
     engine/Directory.Build.props, and depends only on framework packages — no engine-kernel or family path
     to drag along. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Babelstone.Notification</RootNamespace>
    <AssemblyName>Babelstone.Notification</AssemblyName>

    <!-- Shared engine build settings (mirrors the orchestrator host csproj; the notification
         subtree is extraction-ready per ADR-PC-019 §P2, so it carries its own copy rather than
         inheriting the engine's). Runtime pinned by ADR-IC-011 — .NET, the same language as the
         engine (ADR-PC-010 §.NET 10 LTS). -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Doc COVERAGE is a docs concern, not a build gate (same stance as the engine/orchestrator):
         CS1591/CS1573 suppressed, doc ROT (malformed XML, broken refs) still fails. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- BackgroundService/IHostedService (NotificationWorker), IServiceCollection (the contribution
         port's ConfigureServices), IConfiguration (NotificationModuleContext), and ILogger — all surfaced
         through Microsoft.Extensions.Hosting (version pinned centrally via Directory.Packages.props). The
         runnable Host.CreateApplicationBuilder + OTLP exporter + typed HttpClient registration live in the
         Host exe, not here. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
