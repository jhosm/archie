<!-- The /notification worker HOST — the §D4/§A2 composition root (ADR-IC-019 §D4 + Amendment 2026-06-24).
     In plain terms: this is the runnable process that wires the family-agnostic core to the concrete
     families. It is the ONE place allowed to name a family (the standing ADR-PC-021 §A2 exemption): it holds
     the explicit list of IFamilyNotificationModule contributions, composes each (ConfigureServices), and
     registers the core's poll-loop worker. A per-service OUTBOX worker (ADR-IC-004): a BackgroundService
     poll-loop host shell, NOT an HTTP API — so Microsoft.NET.Sdk.Worker, NOT Microsoft.NET.Sdk.Web.

     This host is NOT a §P1 core project, so NOTIFICATION_FAMILY_AGNOSTIC does NOT gate it — it MAY (and
     does) ProjectReference families/** to compose them. The family-agnostic core (Babelstone.Notification)
     is the gated unit; the family knowledge lives in the families/**/.Notification contributions. Extraction-
     ready subtree (ADR-PC-019 §P2): the host carries its OWN copy of the shared engine build settings rather
     than inheriting engine/Directory.Build.props, as the orchestrator host does. -->
<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Babelstone.Notification.Host</RootNamespace>
    <AssemblyName>Babelstone.Notification.Host</AssemblyName>

    <!-- The ADR-PC-040 §D2 covenant role: this host is its estate's COMPOSITION ROOT — the one
         explicit, visible opt-out that MAY ProjectReference families/** (the ADR-PC-021 §A2
         standing-exemption pattern: the family references are the module loader's scan anchor).
         Every project WITHOUT this marker is a family-agnostic core by default, gated repo-wide by
         FAMILY_TO_CORE_DEFAULT_DENY; a marked root is gated instead by
         COMPOSITION_ROOT_NAMES_NO_FAMILY (its Program.cs names no Babelstone.Families.* type). -->
    <BabelstoneRole>CompositionRoot</BabelstoneRole>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The worker host builder (Host.CreateApplicationBuilder + BackgroundService registration). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- The host-side OTel-SDK seam (ADR-IC-007 Layer 1): this composition root registers the
         TracerProvider + OTLP exporter so spans the host opens on the shared Babelstone ActivitySource are
         created and exported to the Collector (§P1 — never direct-to-backend). -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- The family-agnostic notification CORE (the loop, schedule pass, dedupe, the
         contribution port — NO deposit read client; that is family-owned, ADR-IC-019 D1). The host composes
         it; the core never references back (ADR-IC-019 §P2). -->
    <ProjectReference Include="../Babelstone.Notification/Babelstone.Notification.csproj" />

    <!-- The DELIVERY half (bd babelstone-60n8.4/.7): the ADR-IC-004 outbox + ADR-IC-011 HMAC-webhook
         transport for SCHEDULED and EVENT_DRIVEN NotificationDue, family-agnostic like the core. Shipped
         beside the host; ACTIVATION is one composition line —
         builder.Services.AddNotificationWebhookDelivery(builder.Configuration) — in Program.cs (dormant
         until Notification:Webhook:EndpointUrl is configured, so adding the line never breaks an
         unconfigured host). -->
    <ProjectReference Include="../Babelstone.Notification.Delivery/Babelstone.Notification.Delivery.csproj" />

    <!-- The shared CADENCE poll-loop machinery (ADR-IC-019 / ADR-PC-036 §Decision 2). Already reachable
         transitively (the core references Babelstone.Cadence); named explicitly because host code uses
         its types directly (CadenceSchedulerOptions, IDedupeLedger/InMemoryDedupeLedger in Program.cs). -->
    <ProjectReference Include="../../../cadence/src/Babelstone.Cadence/Babelstone.Cadence.csproj" />

    <!-- The shared generic FamilyModuleScanner (ADR-PC-040 §D4) this host's module loader delegates
         its discovery mechanics to — its own tiny assembly (composition/), separate from the Cadence
         poll-loop library above. -->
    <ProjectReference Include="../../../composition/src/Babelstone.Composition/Babelstone.Composition.csproj" />

    <!-- The family NOTIFICATION contributions the host composes — the §A2 exemption: the host MAY name a
         family; the core MAY NOT (ADR-IC-019 §D4). Adding a family is a new line here + its module, zero
         core diff. -->
    <ProjectReference Include="../../../families/term-deposit/src/Babelstone.Families.TermDeposit.Notification/Babelstone.Families.TermDeposit.Notification.csproj" />

    <!-- The pack model + structural parser (ADR-PC-007). The host (the §A2 composition root, NOT a gated
         core project) resolves the instance-pinned regulatory pack at startup and conveys its declared
         template_refs + numeric parameters into NotificationModuleContext as plain, generic data, so a family
         module sources its template-set/window from the pinned pack without the family-agnostic core ever
         referencing Babelstone.Packs (ADR-IC-019 §P2 preserved — NotificationFamilyAgnosticTests gates the
         core, not this host; bd babelstone-60n8.6). -->
    <ProjectReference Include="../../../engine/src/Babelstone.Packs/Babelstone.Packs.csproj" />

    <!-- The SDK-free shared telemetry LEAF (ADR-PC-019 §P2): BabelstoneResource (the OBS-1 resource
         contract) + BabelstoneTelemetry (the shared ActivitySource). Referenced directly, not via the engine
         kernel (this host references no kernel), exactly as the orchestrator host does. -->
    <ProjectReference Include="../../../engine/src/Babelstone.Telemetry/Babelstone.Telemetry.csproj" />

    <!-- The shared host-side OTel-SDK seam (ADR-IC-007 §P4, bd njt2.9–2.10): the AddBabelstonePiiGuard
         runtime no-PII guard this host registers on its trace + log providers. A telemetry leaf with no
         engine-kernel, family, or Postgres-driver path (the seam keeps Npgsql.OpenTelemetry
         PrivateAssets="all"), so it keeps the notification subtree DB-free and family-agnostic
         (ADR-IC-019 §D2/§P2) — NOT a NotificationFamilyAgnosticTests spine project, and the host (not the
         core) is the §A2 holder of OTel-SDK wiring. -->
    <ProjectReference Include="../../../engine/src/Babelstone.Telemetry.Hosting/Babelstone.Telemetry.Hosting.csproj" />
  </ItemGroup>
</Project>
