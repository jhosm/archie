<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Line/branch coverage collector (build-time only; PrivateAssets=all keeps it
         out of any consuming graph). Activated by the XPlat Code Coverage VSTest collector. -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <!-- The durable-store Integration tier (bd babelstone-60n8.10): a real PostgreSQL via
         Testcontainers (the same tier shape as the orchestrator's and the lifecycle driver's), plus
         Npgsql for direct row assertions. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- Decode the relay's Confluent wire-format value back through the governed schema (Apache.Avro)
         and assert the CloudEvents headers (Confluent.Kafka Headers type) — no broker, no Docker. -->
    <PackageReference Include="Apache.Avro" />
    <PackageReference Include="Confluent.Kafka" />
    <!-- The FORMAL Pact CDC consumer half (bd babelstone-2t16.14, ADR-IC-009): generates the
         notification-delivery ⇄ engine message pact and drift-checks it against the committed
         contracts/pact/ artefact. Pinned to 4.5 (see Directory.Packages.props — PactNet 5.0.x
         message verification is broken upstream, pact-net #530). TEST-only. -->
    <PackageReference Include="PactNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The delivery half under test (bd babelstone-60n8.4/.7): the ADR-IC-011 HMAC signature scheme +
         §D4 retry schedule, the ADR-IC-004 in-memory outbox's idempotent enqueue + status lifecycle, the
         SCHEDULED-leg sink mapping, and the drain pass end-to-end over a fake HttpMessageHandler (no
         receiver, no Docker) — delivery, stable idempotency key across retries, backoff, Retry-After,
         permanent-4xx abandonment, §D4 exhaustion dead-lettering, and the EVENT_DRIVEN leg's render-time
         PII resolution that never persists PII. -->
    <ProjectReference Include="../../src/Babelstone.Notification.Delivery/Babelstone.Notification.Delivery.csproj" />
    <!-- The shared container-startup throttle (a TEST-only cross-subtree reference, the same one the
         lifecycle driver's tests take — the extraction-ready posture constrains src/, not tests/). -->
    <ProjectReference Include="../../../engine/tests/Babelstone.TestFixtures/Babelstone.TestFixtures.csproj" />
  </ItemGroup>
</Project>
