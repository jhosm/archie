<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Line/branch coverage collector (build-time only; PrivateAssets=all keeps it
         out of any consuming graph). Activated by the XPlat Code Coverage VSTest collector. -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <!-- Real PostgreSQL per the saga persistence tests (ADR-IC-009). The integration tests
         carry [Trait("Category","Integration")]; the default CI lane filters them out and
         the integration lane (Q.1) runs them — the same convention as the engine tests. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Npgsql" />
    <!-- The consume-loop integration test (t7o3.2) produces real CloudEvents-headed records onto
         Redpanda and hosts the SagaInboxConsumerService, so it needs the Kafka producer and the
         generic-host builder directly (alongside Babelstone.TestFixtures' shared RedpandaFixture). -->
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- AddHttpClient + IHttpClientFactory for the dispatcher integration test's host (bd
         babelstone-t7o3.3): the dispatcher delivers commands over HTTP, so the test host wires the
         same client factory the production Program.cs does. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- WireMock.Net (bd babelstone-t7o3.4): the in-process Core-ACL settlement stub the gated-
         settlement integration test points the dispatcher's SettlementBaseUrl at (the v1 stub; the
         real ACL is DEF-1, bd ub9s). Test-only — it does NOT widen the runtime orchestrator graph. -->
    <PackageReference Include="WireMock.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Babelstone.Orchestrator/Babelstone.Orchestrator.csproj" />
    <!-- The SHARED Redpanda Testcontainers fixture (ic10): the single source of the broker setup
         the engine producer/consumer lanes already reuse — the orchestrator's consume-loop lane
         reuses it too rather than copy-pasting the broker bring-up. A TEST-only reference: it does
         NOT widen the runtime orchestrator's dependency graph (ADR-PC-019 §P2 is a runtime-subtree
         concern), so the extraction-ready boundary is unaffected. -->
    <ProjectReference Include="../../../engine/tests/Babelstone.TestFixtures/Babelstone.TestFixtures.csproj" />
  </ItemGroup>
</Project>
