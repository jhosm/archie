<!-- Microsoft.NET.Sdk.Web adds the ASP.NET Core / Kestrel framework reference the I.1 edge
     HTTP surface needs (ADR-IC-006 §P4 / Document 05 §Step 0): the orchestrator hosts its own
     202 + SSE front door alongside the existing hosted consume loop + dispatcher + migration
     service. This is a FRAMEWORK reference, NOT an engine-kernel ProjectReference — the
     orchestrator subtree stays extraction-ready (ADR-PC-019 §P2: there is no Babelstone.Engine /
     Babelstone.Engine.Avro to shed). The same SDK the engine API hosts use. -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Babelstone.Orchestrator</RootNamespace>
    <AssemblyName>Babelstone.Orchestrator</AssemblyName>

    <!-- Shared engine build settings (mirrors engine/Directory.Build.props; the
         orchestrator subtree is extraction-ready per ADR-PC-019 §P2, so it carries its
         own copy rather than inheriting the engine's). Runtime pinned by ADR-IC-003's S2
         decision — .NET, the same language as the engine (ADR-PC-010 §.NET 10 LTS). -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Doc COVERAGE is a docs concern, not a build gate (same stance as the engine):
         CS1591/CS1573 suppressed, doc ROT (malformed XML, broken refs) still fails. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The DDL ships as embedded, numbered, forward-only SQL resources (ADR-PC-001 §P5,
         lifted from Babelstone.EventStore.Migrations). The runner reads them out of the
         assembly so a deploy carries its own schema; no loose-file lookup at runtime. -->
    <EmbeddedResource Include="Migrations/Sql/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Npgsql is the orchestrator's data dependency: it persists saga state, the transition
         history, the saga_outbox commands, and the inbox dedup row in the application database
         (ADR-IC-003 §S2 "saga state is a table in the application database"). -->
    <PackageReference Include="Npgsql" />
    <!-- Confluent.Kafka is the consume-loop dependency (t7o3.2): the orchestrator IS a Redpanda
         consumer (ADR-IC-003 §S2 "a Redpanda consumer like every other service"), so the host-wired
         SagaConsumeLoop subscribes to the saga's topics, reads the CloudEvents Binary-mode headers
         (ADR-IC-015), and commits offsets. DELIBERATELY no Avro/Schema-Registry surface and no
         engine-kernel reference: the saga keys its transition table on the event TYPE NAME alone
         (ADR-IC-003 §P2), never the Avro payload, so the loop decodes HEADERS only — which keeps the
         orchestrator subtree extraction-ready (ADR-PC-019 §P2: no Babelstone.Engine / Babelstone.Engine.Avro
         to shed). The earlier "NO Confluent surface HERE" note (substrate H.1) is now lifted: H.1 built
         the decoupled SagaAdvanceHandler against a bare PostgreSQL; t7o3.2 adds the real consume loop
         that owns the connection/transaction/offset and drives that handler. -->
    <PackageReference Include="Confluent.Kafka" />
    <!-- BackgroundService/IHostedService (the saga worker host shell, ADR-IC-003 §S2) and
         IHttpClientFactory (the saga command DISPATCHER, bd babelstone-t7o3.3 / ADR-PC-029) are
         BOTH supplied by the Microsoft.AspNetCore.App shared framework the Microsoft.NET.Sdk.Web
         brings in (for the I.1 edge HTTP surface) — so the explicit Hosting/Http PackageReferences
         are pruned (NU1510). The dispatcher still rides HTTP point-to-point (the bus stays
         events-only); the framework reference is ASP.NET Core, NOT an engine-kernel ProjectReference,
         so the subtree stays extraction-ready (ADR-PC-019 §P2). -->

    <!-- The SHARED Babelstone telemetry surface (ADR-IC-007 Layer 1): the orchestrator opens
         its saga-advance spans on the SAME Babelstone.Engine ActivitySource the engine uses —
         one instrumentation scope across the estate, never a competing source — and tags them
         with the shared babelstone.* structural keys (H.5). A small, leaf library with no DB or
         Confluent surface, so referencing it keeps the orchestrator extraction-ready
         (ADR-PC-019 §P2): Babelstone.Telemetry depends on nothing the orchestrator must shed. -->
    <ProjectReference Include="../../../engine/src/Babelstone.Telemetry/Babelstone.Telemetry.csproj" />

    <!-- The family-agnostic saga substrate (ADR-IC-018 §P1): the host composes its runtime,
         stores, and ports. -->
    <ProjectReference Include="../Babelstone.Orchestrator.Substrate/Babelstone.Orchestrator.Substrate.csproj" />
    <!-- The term-deposit family's saga module (ADR-IC-018 §D4): the host is the §D4 composition
         root — the standing, intended exemption (ADR-PC-021 §A2's pattern) that MAY reference a
         family/** project so it can compose the modules. The substrate may NOT. -->
    <ProjectReference Include="../../../families/term-deposit/src/Babelstone.Families.TermDeposit.Orchestration/Babelstone.Families.TermDeposit.Orchestration.csproj" />
  </ItemGroup>
</Project>
