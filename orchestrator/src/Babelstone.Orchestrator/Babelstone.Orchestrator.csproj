<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Babelstone.Orchestrator</RootNamespace>
    <AssemblyName>Babelstone.Orchestrator</AssemblyName>

    <!-- Shared engine build settings (mirrors engine/Directory.Build.props; the
         orchestrator subtree is extraction-ready per ADR-PC-019 §P2, so it carries its
         own copy rather than inheriting the engine's). Runtime pinned by ADR-IC-003's S2
         decision — .NET, the same language as the engine (ADR-PC-010 §.NET 10 LTS). -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Doc COVERAGE is a docs concern, not a build gate (same stance as the engine):
         CS1591/CS1573 suppressed, doc ROT (malformed XML, broken refs) still fails. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The DDL ships as embedded, numbered, forward-only SQL resources (ADR-PC-001 §P5,
         lifted from Babelstone.EventStore.Migrations). The runner reads them out of the
         assembly so a deploy carries its own schema; no loose-file lookup at runtime. -->
    <EmbeddedResource Include="Migrations/Sql/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Npgsql is the only data dependency: the orchestrator persists saga state, the
         transition history, and the inbox dedup row in the application database (ADR-IC-003
         §S2 "saga state is a table in the application database"). NO Confluent/Avro surface
         HERE — the substrate is decoupled from the consume loop (the engine's InboxPump
         plugs in via its IInboxMessageHandler seam, G.2) so it is testable against a bare
         PostgreSQL. -->
    <PackageReference Include="Npgsql" />
    <!-- BackgroundService/IHostedService host shell for the saga worker (ADR-IC-003 §S2
         "a Redpanda consumer like every other service"). The same Microsoft.Extensions
         line the engine relay/consumer use. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
