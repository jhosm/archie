@startuml c4-l2-runtime-write-read
' Source of truth for Level 2.1 in ../feature-design-c4-architecture.md.
' Regenerate: plantuml -tsvg <this file>
!include <C4/C4_Container>
' Remote fallback: !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

AddElementTag("estate", $bgColor="#2E7D6B", $fontColor="#FFFFFF", $borderColor="#1F5749", $legendText="Inherited integration estate (operated, defined in integration_concepts/)")

title Container — L2.1 Runtime write/read path & legacy integration

System_Ext(channels, "Channels", "Mobile / web / branch / call centre acting for a customer or clerk")

System_Boundary(engine_sys, "Core Banking Product Engine") {
  Container(engine, "Engine process", "C# / .NET 10 — single deployable", "Idempotent command ingress (ADR-PC-029); family decider + PURE fold handlers (ADR-PC-021); hand-rolled event-sourcing core (append/load); projection runtime; outbox-relay + inbox workers. NO sagas — those are the orchestrator's")
  ContainerDb(pg, "Engine PostgreSQL", "PostgreSQL", "events (source of truth, self-describing JSON) + outbox + read-model projections + command_dedup + pack_versions. Saga state is NOT here")
}

Container(kong, "Kong Gateway CE", "Kong / nginx, DB-less", "Edge: JWT, PSD2 SCA, rate-limit, payload validation, SSE proxy, mTLS to upstream, OTel", $tags="estate")
Container(orch, "Saga orchestrator", "C# (estate, in-house; ADR-IC-018)", "Edge front door: STARTs the constitution saga, returns 202 + process_id + SSE; family-agnostic saga substrate + family-owned saga modules; drives the engine + ACL", $tags="estate")
ContainerDb(orchpg, "Orchestrator PostgreSQL", "PostgreSQL", "saga_state + saga_transition + saga_outbox + inbox; own role babelstone_orchestrator", $tags="estate")
Container(redpanda, "Redpanda CE + Schema Registry", "Kafka API + Confluent SR", "Event backbone; Avro on the wire; topic per aggregate_type", $tags="estate")
Container(acl, "ACL service (Deposits)", "dedicated service", "Outbound hand-rolled Core clients (SOAP/REST/MQ); pluggable inbound adapter (webhook/poll/MQ); per-adapter circuit-breaker + bulkhead; reconciler", $tags="estate")
ContainerDb(acldb, "ACL PostgreSQL", "PostgreSQL", "idempotency keys, id mappings, in-flight / INDETERMINATE state, inbound dedup, own outbox", $tags="estate")

System_Ext(core, "Core Banking (Legacy)", "Owns the conta à ordem; SoR for legacy deposits; daily DDA batch extract")

Rel(channels, kong, "Commands / queries; subscribe to SSE status stream", "HTTPS REST / SSE")
Rel(kong, orch, "Saga-shaped ops (constitution): START + follow", "HTTPS, mTLS")
Rel(kong, engine, "Direct commands / queries + sync authorization", "HTTPS, mTLS; idempotent ingress")
Rel(orch, engine, "Drive lifecycle commands (ActivateDeposit, ...)", "mTLS; idempotent command ingress")
Rel(orch, orchpg, "saga_state + audit + saga_outbox in one local tx", "SQL")
Rel(engine, pg, "Append events + outbox + command_dedup in ONE local tx; load streams; read projections", "SQL / Npgsql")
Rel(engine, redpanda, "Outbox relay: publish catalogued integration events; inbox: consume confirmations", "polling publisher (ADR-IC-004), Avro")
Rel(orch, acl, "Settlement / domain commands (reserve, confirm, reverse)", "mTLS, orchestrator identity only (ADR-IC-016)")
Rel(acl, acldb, "State + outbox in one local tx", "SQL")
Rel(acl, core, "Execute money movements; observe results", "SOAP / REST / MQ; idempotent")
Rel(core, acl, "Async confirmations + daily DDA batch", "webhook / poll / MQ")
Rel(acl, redpanda, "Confirmation events via own outbox", "Avro")
Rel(redpanda, orch, "Consume ACL confirmations + saga events; advance saga", "Avro")

SHOW_LEGEND()
@enduml
