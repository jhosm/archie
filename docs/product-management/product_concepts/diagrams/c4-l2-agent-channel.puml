@startuml c4-l2-agent-channel
' Source of truth for Level 2.4 in ../feature-design-c4-architecture.md.
' Regenerate: plantuml -tsvg <this file>
!include <C4/C4_Container>
' Remote fallback: !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

AddElementTag("estate", $bgColor="#2E7D6B", $fontColor="#FFFFFF", $borderColor="#1F5749", $legendText="Inherited integration estate (operated, defined in integration_concepts/)")

title Container — L2.4 Agent channel & async completion

Person_Ext(agent, "AI / LLM Agent", "Untrusted agent acting for a customer or staff member")
System_Ext(channels, "Owned channels", "Web / mobile that can hold an SSE connection open")
System_Ext(iam, "Identity / IAM", "OAuth 2.1 AS; RFC 8707 audience binding; SCA; revocation")
System_Ext(subscriber, "Agent callback endpoint", "Pre-registered HTTPS endpoint for async completion")

Container(kong, "Kong Gateway CE", "Kong / nginx", "One route per surface — REST, SSE, MCP (Streamable HTTP); JWT (+aud) / SCA / rate-limit / mTLS / OTel", $tags="estate")
Container(mcp, "MCP server", "Python, MCP SDK, Streamable HTTP", "tools→commands & on-demand reads (model-invokable), resources→host-attached context, prompts; publishes RFC 9728 Protected Resource Metadata", $tags="estate")
Container(redpanda, "Redpanda CE", "Kafka API", "Carries saga terminal events to the notification service", $tags="estate")
Container(notify, "Notification service", "service", "Delivers async saga-completion callbacks (HMAC, at-least-once)", $tags="estate")

System_Boundary(engine_sys, "Core Banking Product Engine") {
  Container(engine, "Engine process", "C# / .NET 9", "Command/query API the MCP server maps onto; emits SagaTerminated terminal events")
}

Rel(agent, iam, "OAuth 2.1 + PKCE; resource = MCP canonical URI", "OIDC")
Rel(agent, kong, "tools/call, resources/read (Bearer)", "MCP / Streamable HTTP")
Rel(channels, kong, "Commands; subscribe to SSE status stream", "REST / SSE")
Rel(kong, iam, "Validate token signature", "JWKS")
Rel(kong, mcp, "Route after JWT (aud) / SCA / rate-limit", "HTTPS, mTLS")
Rel(kong, engine, "Route REST + proxy SSE stream", "HTTPS, mTLS")
Rel(mcp, engine, "Map tool calls→commands & reads (control-ownership, not CQRS)", "internal API")
Rel(engine, redpanda, "Emit SagaTerminated", "Avro")
Rel(redpanda, notify, "Terminal events", "Avro consume")
Rel(notify, subscriber, "HMAC-signed completion callback", "HTTPS POST")

SHOW_LEGEND()
@enduml
